---
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/utils';

export interface FAQItem {
  question: string;
  answer: string;
}

export interface Props {
  faqs?: FAQItem[];
  lang?: Lang;
}

const { lang = 'pt' } = Astro.props;
const t = useTranslations(lang);

const defaultFaqs: FAQItem[] = [
  { question: t('faq.q1'), answer: t('faq.a1') },
  { question: t('faq.q2'), answer: t('faq.a2') },
  { question: t('faq.q3'), answer: t('faq.a3') },
  { question: t('faq.q4'), answer: t('faq.a4') },
];

const { faqs = defaultFaqs } = Astro.props;

const contactHref = lang === 'pt' ? '/contacto' :
  lang === 'en' ? '/en/contact' :
  lang === 'fr' ? '/fr/contact' :
  lang === 'es' ? '/es/contacto' :
  '/de/kontakt';
---

<section class="py-16 lg:py-24 bg-[#F5F5F5]" aria-labelledby="faq-heading">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <span class="inline-block text-[#8B1A1A] text-sm font-semibold uppercase tracking-widest mb-2">{t('faq.title')}</span>
      <h2 id="faq-heading" class="text-3xl lg:text-4xl font-black text-[#1A1A1A] mb-4">
        {t('faq.subtitle')}
      </h2>
    </div>

    <div class="space-y-3">
      {faqs.map((faq, index) => (
        <details
          class="bg-white rounded-xl border border-gray-200 overflow-hidden group"
          id={`faq-${index}`}
        >
          <summary class="flex items-center justify-between gap-4 px-6 py-4 cursor-pointer list-none hover:bg-gray-50 transition-colors">
            <h3 class="font-semibold text-[#1A1A1A] text-base pr-2">{faq.question}</h3>
            <span class="flex-shrink-0 w-6 h-6 flex items-center justify-center rounded-full bg-red-50 text-[#8B1A1A] group-open:bg-[#8B1A1A] group-open:text-white transition-colors" aria-hidden="true">
              <svg class="w-4 h-4 transition-transform group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
              </svg>
            </span>
          </summary>
          <div class="px-6 pb-4 pt-0">
            <p class="text-gray-600 text-sm leading-relaxed">{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>

    <!-- Still have questions -->
    <div class="mt-10 text-center">
      <p class="text-gray-500 mb-4">
        {lang === 'pt' ? 'Não encontrou a resposta que procura?' :
         lang === 'en' ? "Didn't find the answer you're looking for?" :
         lang === 'fr' ? "Vous n'avez pas trouvé la réponse que vous cherchez?" :
         lang === 'es' ? '¿No encontró la respuesta que busca?' :
         'Haben Sie die gesuchte Antwort nicht gefunden?'}
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href={contactHref}
          class="inline-flex items-center justify-center gap-2 border-2 border-[#8B1A1A] text-[#8B1A1A] font-semibold px-6 py-3 rounded-lg hover:bg-[#8B1A1A] hover:text-white transition-colors text-sm"
        >
          {lang === 'pt' ? 'Enviar uma pergunta' :
           lang === 'en' ? 'Send a question' :
           lang === 'fr' ? 'Envoyer une question' :
           lang === 'es' ? 'Enviar una pregunta' :
           'Frage senden'}
        </a>
        <a
          href="tel:+351923348323"
          class="inline-flex items-center justify-center gap-2 bg-[#8B1A1A] text-white font-semibold px-6 py-3 rounded-lg hover:bg-[#A52020] transition-colors text-sm"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
          </svg>
          {t('hero.cta.phone')}
        </a>
      </div>
    </div>

  </div>
</section>
