---
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = 'pt' } = Astro.props;
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();

const links = {
  home:     lang === 'pt' ? '/' : `/${lang}/`,
  electric: lang === 'pt' ? '/servicos/estores-eletricos'
          : lang === 'en' ? '/en/services/electric-blinds'
          : lang === 'fr' ? '/fr/services/stores-electriques'
          : lang === 'es' ? '/es/servicios/persianas-electricas'
          : lang === 'de' ? '/de/dienstleistungen/elektrische-jalousien'
          : '/it/servizi/tende-elettriche',
  manual:   lang === 'pt' ? '/servicos/estores-manuais'
          : lang === 'en' ? '/en/services/manual-blinds'
          : lang === 'fr' ? '/fr/services/stores-manuels'
          : lang === 'es' ? '/es/servicios/persianas-manuales'
          : lang === 'de' ? '/de/dienstleistungen/manuelle-jalousien'
          : '/it/servizi/tende-manuali',
  repair:   lang === 'pt' ? '/servicos/reparacao-estores'
          : lang === 'en' ? '/en/services/blind-repair'
          : lang === 'fr' ? '/fr/services/reparation-stores'
          : lang === 'es' ? '/es/servicios/reparacion-persianas'
          : lang === 'de' ? '/de/dienstleistungen/jalousien-reparatur'
          : '/it/servizi/riparazione-tende',
  quote:    lang === 'pt' ? '/orcamento'
          : lang === 'en' ? '/en/quote'
          : lang === 'fr' ? '/fr/devis'
          : lang === 'es' ? '/es/presupuesto'
          : lang === 'de' ? '/de/angebot'
          : '/it/preventivo',
  contact:  lang === 'pt' ? '/contacto'
          : lang === 'en' ? '/en/contact'
          : lang === 'fr' ? '/fr/contact'
          : lang === 'es' ? '/es/contacto'
          : lang === 'de' ? '/de/kontakt'
          : '/it/contatto',
  zones:    lang === 'pt' ? '/zonas-que-servimos'
          : lang === 'en' ? '/en/coverage-areas'
          : lang === 'fr' ? '/fr/zones-couvertes'
          : lang === 'es' ? '/es/zonas-cobertura'
          : lang === 'de' ? '/de/versorgungsgebiete'
          : '/it/zone-servite',
};

const desc =
  lang === 'en' ? 'Specialists in electric and manual blind installation and repair across Greater Lisbon. Over 10 years of experience at your service.' :
  lang === 'fr' ? 'Spécialistes en installation et réparation de stores électriques et manuels dans tout le Grand Lisbonne. Plus de 10 ans d\'expérience à votre service.' :
  lang === 'es' ? 'Especialistas en instalación y reparación de persianas eléctricas y manuales en todo el Gran Lisboa. Más de 10 años de experiencia a su servicio.' :
  lang === 'de' ? 'Spezialisten für Installation und Reparatur von elektrischen und manuellen Jalousien in ganz Groß-Lissabon. Über 10 Jahre Erfahrung zu Ihren Diensten.' :
  lang === 'it' ? 'Specialisti in installazione e riparazione di tende elettriche e manuali in tutta la Grande Lisbona. Oltre 10 anni di esperienza al vostro servizio.' :
  'Especialistas em instalação e reparação de estores elétricos e manuais em toda a Grande Lisboa. Mais de 10 anos de experiência ao seu serviço.';

const hoursLabel =
  lang === 'en' ? 'Hours' :
  lang === 'fr' ? 'Horaires' :
  lang === 'es' ? 'Horario' :
  lang === 'de' ? 'Öffnungszeiten' :
  lang === 'it' ? 'Orari' :
  'Horário';

const hoursValue =
  lang === 'en' ? 'Monday to Saturday: 8am – 8pm' :
  lang === 'fr' ? 'Lundi au Samedi: 08h00 – 20h00' :
  lang === 'es' ? 'Lunes a Sábado: 08h00 – 20h00' :
  lang === 'de' ? 'Montag bis Samstag: 08:00 – 20:00 Uhr' :
  lang === 'it' ? 'Lunedì al Sabato: 08:00 – 20:00' :
  'Segunda a Sábado: 08h00 – 20h00';

const infoLabel =
  lang === 'en' ? 'Information' :
  lang === 'fr' ? 'Informations' :
  lang === 'es' ? 'Información' :
  lang === 'de' ? 'Informationen' :
  lang === 'it' ? 'Informazioni' :
  'Informações';

const ctaFreeQuote =
  lang === 'en' ? '100% Free Quote' :
  lang === 'fr' ? 'Devis 100% Gratuit' :
  lang === 'es' ? 'Presupuesto 100% Gratis' :
  lang === 'de' ? '100% Kostenloser Kostenvoranschlag' :
  lang === 'it' ? 'Preventivo 100% Gratuito' :
  'Orçamento 100% Gratuito';

const ctaResponse =
  lang === 'en' ? 'Response in less than 24 hours' :
  lang === 'fr' ? 'Réponse en moins de 24 heures' :
  lang === 'es' ? 'Respuesta en menos de 24 horas' :
  lang === 'de' ? 'Antwort in weniger als 24 Stunden' :
  lang === 'it' ? 'Risposta in meno di 24 ore' :
  'Resposta em menos de 24 horas';

const ctaButton =
  lang === 'en' ? 'Get Quote' :
  lang === 'fr' ? 'Demander Devis' :
  lang === 'es' ? 'Pedir Presupuesto' :
  lang === 'de' ? 'Angebot anfragen' :
  lang === 'it' ? 'Richiedi Preventivo' :
  'Pedir Orçamento';

const rightsText =
  lang === 'en' ? 'All rights reserved.' :
  lang === 'fr' ? 'Tous droits réservés.' :
  lang === 'es' ? 'Todos los derechos reservados.' :
  lang === 'de' ? 'Alle Rechte vorbehalten.' :
  lang === 'it' ? 'Tutti i diritti riservati.' :
  'Todos os direitos reservados.';

// ── Social links — update these URLs ──────────────────────────────────────
const socialLinks = [
  {
    name: 'Instagram',
    href: 'https://www.instagram.com/primeestores_',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>`,
  },
  {
    name: 'Facebook',
    href: 'https://www.facebook.com/primeestores_',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>`,
  },
  {
    name: 'LinkedIn',
    href: 'https://www.linkedin.com/company/primeestores_',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  },
];
---

<footer class="bg-[#1A1A1A] text-white" aria-label="Footer">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">

      <!-- Brand column -->
      <div class="sm:col-span-2 lg:col-span-1">
        <a href={links.home} class="inline-flex flex-col leading-tight mb-4 group" aria-label="Prime Estores">
          <div class="flex items-baseline gap-1 whitespace-nowrap">
            <span class="text-lg sm:text-2xl font-black text-[#C0392B] tracking-tight">PRIME</span>
            <span class="text-lg sm:text-2xl font-black text-white tracking-tight">ESTORES</span>
          </div>
          <span class="text-xs font-semibold text-[#C0392B] tracking-widest uppercase -mt-1">Instalação &amp; Reparação</span>
        </a>
        <p class="text-gray-400 text-sm leading-relaxed mb-4">{desc}</p>
        <div class="space-y-2">
          <a href="tel:+351923348323" class="flex items-center gap-2 text-white hover:text-[#C0392B] transition-colors text-sm font-medium">
            <svg class="w-4 h-4 text-[#C0392B]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
            </svg>
            +351 923 348 323
          </a>
          <a href="mailto:info@primeestores.pt" class="flex items-center gap-2 text-white hover:text-[#C0392B] transition-colors text-sm font-medium">
            <svg class="w-4 h-4 text-[#C0392B]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            info@primeestores.pt
          </a>
        </div>
        <div class="mt-4 flex items-start gap-2">
          <svg class="w-4 h-4 text-[#C0392B] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <div class="text-sm text-gray-400">
            <div class="text-white font-medium mb-0.5">{hoursLabel}</div>
            {hoursValue}
          </div>
        </div>

        <!-- Social links -->
        <div class="mt-5 flex items-center gap-3 flex-wrap">
          {socialLinks.map(social => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={social.name}
              class="w-9 h-9 rounded-full bg-white/10 hover:bg-[#C0392B] flex items-center justify-center text-gray-400 hover:text-white transition-colors"
              set:html={social.icon}
            />
          ))}
        </div>
        <!-- Zaask badge -->
        <div class="mt-3">
          <a
            href="https://www.zaask.pt/user/primeestores"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Prime Estores no Zaask"
          >
            <img
              src="https://www.zaask.pt/widget?user=484564&widget=pro-findme"
              alt="Prime Estores no Zaask"
              class="h-10 w-auto max-w-full"
              loading="lazy"
              width="160"
              height="40"
            />
          </a>
        </div>
      </div>

      <!-- Services column -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">{t('footer.services')}</h3>
        <ul class="space-y-2">
          <li>
            <a href={links.electric} class="text-gray-400 hover:text-white transition-colors text-sm">{t('nav.services.electric')}</a>
          </li>
          <li>
            <a href={links.manual} class="text-gray-400 hover:text-white transition-colors text-sm">{t('nav.services.manual')}</a>
          </li>
          <li>
            <a href={links.repair} class="text-gray-400 hover:text-white transition-colors text-sm">{t('nav.services.repair')}</a>
          </li>
          <li>
            <a href={links.quote} class="text-gray-400 hover:text-white transition-colors text-sm">{t('nav.quote')}</a>
          </li>
          <li>
            <a href={links.contact} class="text-gray-400 hover:text-white transition-colors text-sm">{t('nav.contact')}</a>
          </li>
        </ul>
      </div>

      <!-- Zones column -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">
          <a href={links.zones} class="hover:text-[#C0392B] transition-colors">{t('footer.zones')}</a>
        </h3>
        <ul class="space-y-2">
          {['Lisboa', 'Sintra', 'Cascais', 'Oeiras', 'Almada', 'Setúbal', 'Amadora', 'Loures', 'Odivelas', 'Mafra'].map(zona => (
            <li>
              <a href={links.zones} class="text-gray-400 hover:text-white transition-colors text-sm">{zona}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Info column -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">{infoLabel}</h3>
        <ul class="space-y-2 mb-6">
          <li>
            <a href={links.home} class="text-gray-400 hover:text-white transition-colors text-sm">{t('nav.home')}</a>
          </li>
          <li>
            <a href={links.zones} class="text-gray-400 hover:text-white transition-colors text-sm">{t('footer.zones')}</a>
          </li>
          <li>
            <a href={links.quote} class="text-gray-400 hover:text-white transition-colors text-sm">{t('nav.quote')}</a>
          </li>
          <li>
            <a href={links.contact} class="text-gray-400 hover:text-white transition-colors text-sm">{t('nav.contact')}</a>
          </li>
        </ul>

        <!-- CTA -->
        <div class="bg-[#8B1A1A] rounded-lg p-4">
          <p class="text-white text-sm font-medium mb-2">{ctaFreeQuote}</p>
          <p class="text-red-200 text-xs mb-3">{ctaResponse}</p>
          <a
            href={links.quote}
            class="block text-center bg-white text-[#8B1A1A] text-sm font-semibold py-2 px-3 rounded-md hover:bg-gray-100 transition-colors"
          >
            {ctaButton}
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="border-t border-gray-800 mt-10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-gray-500 text-sm">
        &copy; {currentYear} Prime Estores. {rightsText}
      </p>
      <p class="text-gray-600 text-xs">
        Lisboa, Portugal &bull; NIF: 123 456 789
      </p>
    </div>
  </div>
</footer>
