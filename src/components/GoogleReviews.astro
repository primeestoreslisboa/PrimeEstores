---
import type { Lang } from '../i18n/routes';
import googleReviews from '../data/google-reviews.json';

interface Props {
  lang?: Lang;
}

const { lang = 'pt' } = Astro.props;

// Values can be overridden by Netlify environment variables (updated in the
// Netlify dashboard + redeploy — no code change). Falls back to the JSON file.
const rating = Number(import.meta.env.PUBLIC_REVIEW_RATING ?? googleReviews.rating);
const reviewCount = Number(import.meta.env.PUBLIC_REVIEW_COUNT ?? googleReviews.reviewCount);
const googleMapsUrl = import.meta.env.PUBLIC_REVIEW_MAPS_URL ?? googleReviews.googleMapsUrl;

const labels = {
  pt: {
    badge: 'Avaliações Google',
    reviews: 'avaliações verificadas',
    cta: 'Ver todas as avaliações no Google',
    title: 'Avaliados pelos Nossos Clientes',
    subtitle: 'Consulte as avaliações reais dos nossos clientes no Google',
    trust1: 'Avaliações 100% verificadas',
    trust2: 'Clientes reais em toda a Grande Lisboa',
    trust3: 'Sem filtragem de comentários',
    quoteHref: '/orcamento',
    quoteCta: 'Pedir Orçamento Grátis',
  },
  en: {
    badge: 'Google Reviews',
    reviews: 'verified reviews',
    cta: 'See all reviews on Google',
    title: 'Rated by Our Clients',
    subtitle: 'Check the real reviews from our clients on Google',
    trust1: '100% verified reviews',
    trust2: 'Real clients across Greater Lisbon',
    trust3: 'No filtered comments',
    quoteHref: '/en/quote',
    quoteCta: 'Get Free Quote',
  },
  fr: {
    badge: 'Avis Google',
    reviews: 'avis vérifiés',
    cta: 'Voir tous les avis sur Google',
    title: 'Évalué par Nos Clients',
    subtitle: 'Consultez les vrais avis de nos clients sur Google',
    trust1: 'Avis 100% vérifiés',
    trust2: 'Vrais clients dans tout le Grand Lisbonne',
    trust3: 'Sans filtrage de commentaires',
    quoteHref: '/fr/devis',
    quoteCta: 'Demander un Devis Gratuit',
  },
  es: {
    badge: 'Reseñas de Google',
    reviews: 'reseñas verificadas',
    cta: 'Ver todas las reseñas en Google',
    title: 'Valorado por Nuestros Clientes',
    subtitle: 'Consulte las reseñas reales de nuestros clientes en Google',
    trust1: 'Reseñas 100% verificadas',
    trust2: 'Clientes reales en todo el Gran Lisboa',
    trust3: 'Sin filtrado de comentarios',
    quoteHref: '/es/presupuesto',
    quoteCta: 'Pedir Presupuesto Gratis',
  },
  de: {
    badge: 'Google-Bewertungen',
    reviews: 'verifizierte Bewertungen',
    cta: 'Alle Bewertungen auf Google ansehen',
    title: 'Von Unseren Kunden Bewertet',
    subtitle: 'Lesen Sie die echten Bewertungen unserer Kunden auf Google',
    trust1: '100% verifizierte Bewertungen',
    trust2: 'Echte Kunden in ganz Groß-Lissabon',
    trust3: 'Keine gefilterten Kommentare',
    quoteHref: '/de/angebot',
    quoteCta: 'Kostenloses Angebot anfordern',
  },
  it: {
    badge: 'Recensioni Google',
    reviews: 'recensioni verificate',
    cta: 'Vedi tutte le recensioni su Google',
    title: 'Valutato dai Nostri Clienti',
    subtitle: 'Consulta le recensioni reali dei nostri clienti su Google',
    trust1: 'Recensioni 100% verificate',
    trust2: 'Clienti reali in tutta la Grande Lisbona',
    trust3: 'Senza filtro di commenti',
    quoteHref: '/it/preventivo',
    quoteCta: 'Richiedi Preventivo Gratuito',
  },
};

const l = labels[lang] ?? labels['pt'];
---

<!-- Schema.org AggregateRating for SEO -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Prime Estores",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Lisboa",
    "addressRegion": "Lisboa",
    "addressCountry": "PT"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": rating.toFixed(1),
    "reviewCount": reviewCount,
    "bestRating": "5",
    "worstRating": "1"
  }
})} />

<section class="py-16 lg:py-24 bg-white" aria-labelledby="reviews-heading">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="text-center mb-10">
      <span class="inline-block text-[#8B1A1A] text-sm font-semibold uppercase tracking-widest mb-2">
        {l.badge}
      </span>
      <h2 id="reviews-heading" class="text-3xl lg:text-4xl font-black text-[#1A1A1A] mb-3">
        {l.title}
      </h2>
      <p class="text-gray-500 text-lg">{l.subtitle}</p>
    </div>

    <!-- Main rating card -->
    <div class="flex flex-col items-center justify-center gap-8 bg-[#F5F5F5] rounded-3xl p-8 lg:p-12 mb-8">

      <!-- Google logo + rating -->
      <div class="flex flex-col sm:flex-row items-center gap-6 lg:gap-10">

        <!-- Google "G" icon -->
        <div class="w-20 h-20 lg:w-24 lg:h-24 flex-shrink-0">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="w-full h-full drop-shadow-md">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
        </div>

        <!-- Score -->
        <div class="text-center sm:text-left">
          <div class="text-7xl lg:text-8xl font-black text-[#1A1A1A] leading-none">{rating.toFixed(1)}</div>
          <div class="flex items-center justify-center sm:justify-start gap-1 mt-2 mb-1">
            {Array.from({ length: 5 }).map(() => (
              <svg class="w-7 h-7 text-yellow-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>
          <div class="text-gray-500 text-sm font-medium">
            {reviewCount} {l.reviews}
          </div>
        </div>
      </div>

      <!-- CTA button -->
      <a
        href={googleMapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 bg-white border-2 border-gray-200 hover:border-[#4285F4] text-[#1A1A1A] font-semibold px-6 py-3.5 rounded-xl transition-all hover:shadow-md text-sm"
        aria-label={l.cta}
      >
        <!-- Google colored icon inline -->
        <svg viewBox="0 0 24 24" class="w-5 h-5 flex-shrink-0" xmlns="http://www.w3.org/2000/svg">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        {l.cta}
        <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
        </svg>
      </a>

      <!-- Trust indicators -->
      <div class="flex flex-col sm:flex-row items-center gap-4 sm:gap-8 text-sm text-gray-500">
        {[l.trust1, l.trust2, l.trust3].map(item => (
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            <span>{item}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Bottom CTA -->
    <div class="text-center">
      <a
        href={l.quoteHref}
        class="inline-flex items-center gap-2 bg-[#8B1A1A] text-white font-bold px-8 py-3.5 rounded-lg hover:bg-[#A52020] transition-colors text-base"
      >
        {l.quoteCta}
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>

  </div>
</section>
