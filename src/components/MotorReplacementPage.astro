    </div>
  </div>

  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-12">
        <div class="lg:col-span-2">
          <h2 class="text-2xl lg:text-3xl font-black text-[#1A1A1A] mb-4">{c.introH2}</h2>
          <p class="text-gray-600 leading-relaxed mb-6">{c.introP1}</p>
          <p class="text-gray-600 leading-relaxed mb-6">{c.introP2}</p>

          <h2 class="text-2xl font-black text-[#1A1A1A] mb-4 mt-8">{c.signsH2}</h2>
          <div class="grid sm:grid-cols-2 gap-3 mb-8">
            {c.signs.map(s => (
              <div class="flex items-center gap-2 p-3 bg-[#F5F5F5] rounded-lg text-sm">
                <svg class="w-4 h-4 text-[#8B1A1A] flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                <span class="text-gray-700">{s}</span>
              </div>
            ))}
          </div>

          <h2 class="text-2xl font-black text-[#1A1A1A] mb-4 mt-8">{c.processH2}</h2>
          <ol class="space-y-4 mb-8">
            {c.process.map(item => (
              <li class="flex gap-4">
                <div class="flex-shrink-0 w-10 h-10 bg-[#8B1A1A] text-white rounded-full flex items-center justify-center font-black text-sm">{item.step}</div>
                <div>
                  <div class="font-semibold text-[#1A1A1A]">{item.title}</div>
                  <div class="text-gray-500 text-sm mt-0.5">{item.desc}</div>
                </div>
              </li>
            ))}
          </ol>

          <h2 class="text-2xl font-black text-[#1A1A1A] mb-4 mt-8">{c.localH2}</h2>
          <p class="text-gray-600 leading-relaxed mb-4">{c.localP}</p>
          <div class="flex flex-wrap gap-2 mb-4">
            {c.zonas.map(zona => (
              <span class="bg-[#F5F5F5] border border-gray-200 text-gray-700 text-sm font-medium px-3 py-1.5 rounded-full">{c.chipPrefix} {zona}</span>
            ))}
          </div>
          <a href={l.zones} class="text-[#8B1A1A] font-semibold hover:underline text-sm">{c.zonesLink}</a>

          <h2 class="text-2xl font-black text-[#1A1A1A] mb-4 mt-10">{c.faqH2}</h2>
          <div class="space-y-3">
            {c.faqs.map((faq, index) => (
              <details class="bg-[#F5F5F5] rounded-xl overflow-hidden group" id={`motor-faq-${index}`}>
                <summary class="flex items-center justify-between gap-4 px-5 py-4 cursor-pointer list-none hover:bg-gray-100 transition-colors">
                  <h3 class="font-semibold text-[#1A1A1A] text-sm pr-2">{faq.q}</h3>
                  <span class="flex-shrink-0 w-6 h-6 flex items-center justify-center rounded-full bg-white text-[#8B1A1A] group-open:bg-[#8B1A1A] group-open:text-white transition-colors" aria-hidden="true">
                    <svg class="w-4 h-4 transition-transform group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                  </span>
                </summary>
                <div class="px-5 pb-4 pt-0"><p class="text-gray-600 text-sm leading-relaxed">{faq.a}</p></div>
              </details>
            ))}
          </div>
        </div>

        <div class="space-y-6">
          <div class="bg-[#8B1A1A] rounded-2xl p-6 text-white">
            <h3 class="font-black text-xl mb-2">{c.sideTitle}</h3>
            <p class="text-red-100 text-sm mb-4">{c.sideText}</p>
            <a href="tel:+351923348323" class="flex items-center justify-center gap-2 bg-white text-[#8B1A1A] font-bold px-4 py-3 rounded-lg hover:bg-gray-100 transition-colors text-sm w-full">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
              +351 923 348 323
            </a>
          </div>
          <ContactForm showTitle={true} lang={lang} />
          <div class="bg-[#F5F5F5] rounded-2xl p-6">
            <h3 class="font-bold text-[#1A1A1A] mb-4">{c.alsoTitle}</h3>
            <ul class="space-y-2 text-sm">
              <li><a href={l.repair} class="text-[#8B1A1A] hover:underline">{c.alsoRepair} →</a></li>
              <li><a href={l.electric} class="text-[#8B1A1A] hover:underline">{c.alsoElectric} →</a></li>
              <li><a href={l.manual} class="text-[#8B1A1A] hover:underline">{c.alsoManual} →</a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <RelatedServices current="repair" lang={lang} />
</Layout>
