const c = content[lang] ?? content.pt;
const l = links[lang] ?? links.pt;
const pageUrl = `${baseUrl}${pagePath[lang] ?? pagePath.pt}`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: c.breadcrumb, item: pageUrl },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<Layout
  title={c.meta.title}
  description={c.meta.description}
  keywords={c.meta.keywords}
  canonicalURL={pageUrl}
  schemaType="Service"
  serviceName={c.meta.serviceName}
  serviceDescription={c.meta.serviceDescription}
  lang={lang}
>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-[#1A1A1A] to-[#8B1A1A] text-white py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 text-sm text-white/80">
          <li><a href={l.home} class="hover:text-white transition-colors">{lang === 'pt' ? 'Início' : lang === 'en' ? 'Home' : lang === 'fr' ? 'Accueil' : lang === 'es' ? 'Inicio' : lang === 'de' ? 'Startseite' : 'Home'}</a></li>
          <li aria-hidden="true"><span>/</span></li>
          <li><span class="text-white">{c.breadcrumb}</span></li>
        </ol>
      </nav>
      <div class="max-w-3xl">
        <span class="inline-block bg-white/10 border border-white/20 text-white text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full mb-4">{c.badge}</span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black leading-tight mb-4">{c.h1}</h1>
        <p class="text-lg sm:text-xl text-white/80 leading-relaxed mb-8">{c.subtitle}</p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href={l.quote} class="inline-flex items-center justify-center gap-2 bg-white text-[#8B1A1A] font-bold px-6 py-3.5 rounded-lg hover:bg-gray-100 transition-colors">
            {c.ctaQuote}
          </a>
          <a href="tel:+351923348323" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white font-bold px-6 py-3.5 rounded-lg hover:bg-white/10 transition-colors">
            +351 923 348 323
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl lg:text-3xl font-black text-[#1A1A1A] mb-4">{c.introHeading}</h2>
      <p class="text-gray-600 leading-relaxed mb-4">{c.introP1}</p>
      <p class="text-gray-600 leading-relaxed">{c.introP2}</p>
    </div>
  </section>

  <!-- Services -->
  <section class="py-16 lg:py-20 bg-[#F5F5F5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl lg:text-3xl font-black text-[#1A1A1A] mb-10 text-center">{c.servicesHeading}</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {c.services.map(s => (
          <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
            <div class="w-12 h-12 bg-[#8B1A1A] rounded-xl flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <Fragment set:html={icons[s.key]} />
              </svg>
            </div>
            <h3 class="font-bold text-[#1A1A1A] mb-2">{s.title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Advantages + process + form -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-12">
        <div class="lg:col-span-2">
          <h2 class="text-2xl lg:text-3xl font-black text-[#1A1A1A] mb-6">{c.advantagesHeading}</h2>
          <div class="grid sm:grid-cols-2 gap-4 mb-10">
            {c.advantages.map(item => (
              <div class="flex gap-3 p-4 bg-[#F5F5F5] rounded-xl">
                <svg class="w-5 h-5 text-[#8B1A1A] flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                <div>
                  <div class="font-semibold text-[#1A1A1A] text-sm">{item.title}</div>
                  <div class="text-gray-500 text-xs mt-0.5">{item.desc}</div>
                </div>
              </div>
            ))}
          </div>

          <h2 class="text-2xl font-black text-[#1A1A1A] mb-6">{c.processHeading}</h2>
          <ol class="space-y-4 mb-10">
            {c.process.map(item => (
              <li class="flex gap-4">
                <div class="flex-shrink-0 w-10 h-10 bg-[#8B1A1A] text-white rounded-full flex items-center justify-center font-black text-sm">{item.step}</div>
                <div>
                  <div class="font-semibold text-[#1A1A1A]">{item.title}</div>
                  <div class="text-gray-500 text-sm mt-0.5">{item.desc}</div>
                </div>
              </li>
            ))}
          </ol>

          <h2 class="text-2xl font-black text-[#1A1A1A] mb-4">{c.zonesHeading}</h2>
          <p class="text-gray-600 leading-relaxed mb-4">{c.zonesText}</p>
          <a href={l.zones} class="text-[#8B1A1A] font-semibold hover:underline text-sm">{c.zonesLink}</a>
        </div>

        <div class="space-y-6">
          <ContactForm showTitle={true} lang={lang} />
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 lg:py-20 bg-[#F5F5F5]" aria-labelledby="smarthome-faq">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 id="smarthome-faq" class="text-2xl lg:text-3xl font-black text-[#1A1A1A] mb-8 text-center">{c.faqHeading}</h2>
      <div class="space-y-3">
        {c.faqs.map((faq, index) => (
          <details class="bg-white rounded-xl border border-gray-200 overflow-hidden group" id={`sh-faq-${index}`}>
            <summary class="flex items-center justify-between gap-4 px-6 py-4 cursor-pointer list-none hover:bg-gray-50 transition-colors">
              <h3 class="font-semibold text-[#1A1A1A] text-base pr-2">{faq.q}</h3>
              <span class="flex-shrink-0 w-6 h-6 flex items-center justify-center rounded-full bg-red-50 text-[#8B1A1A] group-open:bg-[#8B1A1A] group-open:text-white transition-colors" aria-hidden="true">
                <svg class="w-4 h-4 transition-transform group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
              </span>
            </summary>
            <div class="px-6 pb-4 pt-0">
              <p class="text-gray-600 text-sm leading-relaxed">{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-16 bg-[#1A1A1A] text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl lg:text-3xl font-black mb-4">{c.finalTitle}</h2>
      <p class="text-gray-400 text-lg mb-8 max-w-2xl mx-auto">{c.finalText}</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={l.quote} class="inline-flex items-center justify-center gap-2 bg-[#8B1A1A] text-white font-bold px-8 py-4 rounded-lg hover:bg-[#7a1717] transition-colors">{c.finalQuote}</a>
        <a href="tel:+351923348323" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white font-bold px-8 py-4 rounded-lg hover:bg-white/10 transition-colors">{c.finalContact}</a>
      </div>
    </div>
  </section>

  <RelatedServices current="smart-home" lang={lang} />
</Layout>
