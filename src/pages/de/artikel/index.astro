---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const lang = 'de' as const;

const posts = (await getCollection('artigos-de')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

function formatDate(date: Date) {
  return date.toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

<Layout
  title="Artikel Prime Estores — Ratgeber und Tipps zu Elektrischen Jalousien"
  description="Praktische Artikel über elektrische und manuelle Jalousien: Preise, Installation, Wartung, Smart Home und vieles mehr. Der Referenzratgeber für Jalousienmontage in Lissabon."
  keywords="Artikel elektrische Jalousien, Jalousien-Ratgeber, Jalousien-Tipps Lissabon, motorisierte Jalousien Artikel"
  lang={lang}
>

  <section class="bg-gradient-to-br from-[#1A1A1A] to-[#8B1A1A] text-white py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Brotkrumen" class="mb-6">
        <ol class="flex items-center gap-2 text-sm text-white/80">
          <li><a href="/de/" class="hover:text-white transition-colors">Startseite</a></li>
          <li aria-hidden="true"><span>/</span></li>
          <li><span class="text-white">Artikel</span></li>
        </ol>
      </nav>
      <div class="max-w-2xl">
        <span class="inline-block bg-white/10 border border-white/20 text-white text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full mb-4">Ratgeber & Tipps</span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black leading-tight mb-4">Prime Estores Artikel</h1>
        <p class="text-xl text-white/80 leading-relaxed">
          Praktische Artikel über elektrische Jalousien, manuelle Jalousien, Motorisierung, Smart Home und Wartung — geschrieben von Spezialisten mit jahrelanger Erfahrung in Lissabon.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-[#F5F5F5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map(post => (
          <article class="bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100 hover:shadow-md transition-shadow flex flex-col">
            <div class="p-6 flex flex-col flex-1">
              <div class="flex items-center gap-3 mb-4">
                <time datetime={post.data.pubDate.toISOString()} class="text-xs text-gray-400 font-medium">
                  {formatDate(post.data.pubDate)}
                </time>
                {post.data.readingTime && (
                  <span class="text-xs text-gray-400">· {post.data.readingTime} Min. Lesezeit</span>
                )}
              </div>
              <h2 class="text-lg font-black text-[#1A1A1A] leading-snug mb-3 hover:text-[#8B1A1A] transition-colors">
                <a href={`/de/artikel/${post.slug}/`}>{post.data.title}</a>
              </h2>
              <p class="text-gray-500 text-sm leading-relaxed flex-1 mb-5">{post.data.description}</p>
              <a href={`/de/artikel/${post.slug}/`} class="inline-flex items-center gap-1 text-[#8B1A1A] font-semibold text-sm hover:gap-2 transition-all hover:underline">
                Artikel lesen
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-white border-t border-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-black text-[#1A1A1A] mb-3">Bereit zur Installation?</h2>
      <p class="text-gray-500 mb-6">Fordern Sie ein kostenloses und unverbindliches Angebot an. Wir decken ganz Groß-Lissabon ab.</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/de/angebot" class="inline-flex items-center justify-center gap-2 bg-[#8B1A1A] text-white font-bold px-6 py-3.5 rounded-lg hover:bg-[#7a1717] transition-colors">
          Kostenloses Angebot
        </a>
        <a href="tel:+351923348323" class="inline-flex items-center justify-center gap-2 border-2 border-[#8B1A1A] text-[#8B1A1A] font-bold px-6 py-3.5 rounded-lg hover:bg-[#8B1A1A] hover:text-white transition-colors">
          +351 923 348 323
        </a>
      </div>
    </div>
  </section>

</Layout>

