---
import Layout from '../../../layouts/Layout.astro';
import ContactForm from '../../../components/ContactForm.astro';
import ServiceExtras from '../../../components/ServiceExtras.astro';
import RelatedServices from '../../../components/RelatedServices.astro';

const lang = 'de' as const;
---

<Layout
  title="Elektroinstallation in Lissabon | Prime Estores"
  description="Installation von Steckdosen, Schaltern, Leuchten und LED-Beleuchtung in Lissabon und Groß-Lissabon. Schneller Service mit zertifizierten Technikern. Kostenloses Angebot."
  keywords="Elektroinstallation Lissabon, Steckdosen Lissabon, Schalter Lissabon, Leuchten Lissabon, LED-Beleuchtung Lissabon, Elektriker Lissabon"
  schemaType="Service"
  serviceName="Elektroinstallation in Lissabon"
  serviceDescription="Installation von Steckdosen, Schaltern, Leuchten und LED-Beleuchtung in Lissabon und Groß-Lissabon. Zertifizierte Techniker mit 1 Jahr Garantie."
  lang={lang}
>

  <!-- Page Hero -->
  <section class="bg-gradient-to-br from-[#1A1A1A] to-[#8B1A1A] text-white py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 text-sm text-white/80">
          <li><a href="/de/" class="hover:text-white transition-colors">Startseite</a></li>
          <li aria-hidden="true"><span>/</span></li>
          <li><span class="text-white">Elektroinstallation</span></li>
        </ol>
      </nav>
      <div class="max-w-3xl">
        <span class="inline-block bg-white/10 border border-white/20 text-white text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full mb-4">Dienstleistung</span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black leading-tight mb-4">
          Elektroinstallation in Lissabon
        </h1>
        <p class="text-xl text-white/80 leading-relaxed mb-8">
          Steckdosen, Schalter, Leuchten und LED-Beleuchtung. Schneller Service mit zertifizierten Technikern in ganz Groß-Lissabon.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/de/angebot" class="inline-flex items-center justify-center gap-2 bg-white text-[#8B1A1A] font-bold px-6 py-3.5 rounded-lg hover:bg-gray-100 transition-colors">
            Kostenloses Angebot anfordern
          </a>
          <a href="tel:+351923348323" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white font-bold px-6 py-3.5 rounded-lg hover:bg-white/10 transition-colors">
            +351 923 348 323
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Main content -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-12">

        <!-- Content -->
        <div class="lg:col-span-2">
          <h2 class="text-2xl lg:text-3xl font-black text-[#1A1A1A] mb-4">Was wir machen</h2>
          <p class="text-gray-600 leading-relaxed mb-6">
            Bei Prime Estores führen wir Elektroarbeiten für Wohnungen und Unternehmen in ganz Groß-Lissabon durch. Von der Installation von Steckdosen und Schaltern bis zur Montage von Leuchten und LED-Beleuchtungssystemen — wir erledigen alles mit Sorgfalt, Schnelligkeit und inklusive Garantie.
          </p>
          <p class="text-gray-600 leading-relaxed mb-6">
            Alle Arbeiten werden von zertifizierten Technikern mit hochwertigen Materialien und unter Einhaltung der geltenden elektrischen Sicherheitsnormen durchgeführt. Ohne Schmutz, ohne Schäden an Wänden, ohne unangenehme Überraschungen.
          </p>

          <h2 class="text-2xl font-black text-[#1A1A1A] mb-4 mt-8">Was wir anbieten</h2>
          <div class="grid sm:grid-cols-2 gap-4 mb-8">
            {[
              { title: 'Steckdoseninstallation', desc: 'Einfache, doppelte, dreifache Steckdosen und USB-Ladesteckdosen' },
              { title: 'Schalterinstallation', desc: 'Einfachschalter, Wechselschalter und Dimmer' },
              { title: 'Leuchtenmontage', desc: 'Deckenleuchten, Wandleuchten und dekorative Pendelleuchten' },
              { title: 'LED-Beleuchtung', desc: 'Einbaustrahler, LED-Streifen, LED-Panels und energiesparende Leuchten' },
              { title: 'Schnelle und saubere Arbeit', desc: 'Keine Schäden an Wänden oder Oberflächen — wir hinterlassen alles so, wie wir es vorgefunden haben' },
              { title: '1 Jahr Garantie', desc: 'Alle durchgeführten Elektroarbeiten haben 1 Jahr Garantie inklusive' },
            ].map(item => (
              <div class="flex gap-3 p-4 bg-[#F5F5F5] rounded-xl">
                <svg class="w-5 h-5 text-[#8B1A1A] flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                <div>
                  <div class="font-semibold text-[#1A1A1A] text-sm">{item.title}</div>
                  <div class="text-gray-500 text-xs mt-0.5">{item.desc}</div>
                </div>
              </div>
            ))}
          </div>

          <h2 class="text-2xl font-black text-[#1A1A1A] mb-4 mt-8">Wie unser Prozess funktioniert</h2>
          <ol class="space-y-4 mb-8">
            {[
              { step: '01', title: 'Kontakt und kostenloses Angebot', desc: 'Nehmen Sie per Telefon oder Formular Kontakt auf. Wir bewerten die Arbeit und erstellen ein unverbindliches Angebot.' },
              { step: '02', title: 'Besichtigung vor Ort', desc: 'Bei komplexeren Aufträgen kommen wir, um die bestehende Installation zu bewerten und die Arbeit zu planen.' },
              { step: '03', title: 'Terminplanung', desc: 'Wir vereinbaren den für Sie günstigsten Termin. Wir garantieren Pünktlichkeit.' },
              { step: '04', title: 'Professionelle Ausführung', desc: 'Unsere Techniker führen die Arbeiten schnell, sauber und sicher durch, unter Einhaltung aller Elektronormen.' },
              { step: '05', title: 'Übergabe und Garantie', desc: 'Wir testen alles vor der Abreise und übergeben den Service mit 1 Jahr Garantie inklusive.' },
            ].map(item => (
              <li class="flex gap-4">
                <div class="flex-shrink-0 w-10 h-10 bg-[#8B1A1A] text-white rounded-full flex items-center justify-center font-black text-sm">
                  {item.step}
                </div>
                <div>
                  <div class="font-semibold text-[#1A1A1A]">{item.title}</div>
                  <div class="text-gray-500 text-sm mt-0.5">{item.desc}</div>
                </div>
              </li>
            ))}
          </ol>

          <h2 class="text-2xl font-black text-[#1A1A1A] mb-4 mt-8">Versorgungsgebiete</h2>
          <p class="text-gray-600 leading-relaxed mb-4">
            Wir bieten Elektroservices in ganz <strong>Groß-Lissabon</strong> an, einschließlich: Lissabon (alle Stadtteile), Sintra, Cascais, Oeiras, Almada, Setúbal, Amadora, Loures, Odivelas, Vila Franca de Xira, Mafra, Sesimbra und Palmela.
          </p>
          <a href="/de/versorgungsgebiete" class="text-[#8B1A1A] font-semibold hover:underline text-sm">
            Alle Versorgungsgebiete anzeigen →
          </a>
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
          <ContactForm showTitle={true} lang={lang} />
          <div class="bg-[#F5F5F5] rounded-2xl p-6">
            <h3 class="font-bold text-[#1A1A1A] mb-4">Nützliche Informationen</h3>
            <div class="space-y-3 text-sm">
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-[#8B1A1A]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <span class="text-gray-600">Antwort innerhalb von 24h</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-[#8B1A1A]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
                <span class="text-gray-600">1 Jahr Garantie</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-[#8B1A1A]" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                <span class="text-gray-600">Kostenloses Angebot</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-[#8B1A1A]" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                <span class="text-gray-600">Zertifizierte Techniker</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <ServiceExtras service="electrical" lang={lang} />
  <RelatedServices current="electrical" lang={lang} />
</Layout>
