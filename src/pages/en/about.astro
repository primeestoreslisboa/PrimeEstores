---
import Layout from '../../layouts/Layout.astro';

const baseUrl = 'https://primeestores.pt';
const pageUrl = `${baseUrl}/en/about/`;

const sobreSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${baseUrl}/#business`,
  name: 'Prime Estores',
  url: baseUrl,
  telephone: '+351923348323',
  email: 'info@primeestores.pt',
  image: `${baseUrl}/og-image.jpg`,
  description: 'Company specialised in the installation and repair of electric and manual blinds in Lisbon and Greater Lisbon since 2015.',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Lisbon',
    addressRegion: 'Lisbon',
    addressCountry: 'PT',
  },
  foundingDate: '2015',
  areaServed: { '@type': 'State', name: 'Greater Lisbon' },
  priceRange: '€€',
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
    opens: '08:00',
    closes: '20:00',
  }],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${baseUrl}/en/` },
    { '@type': 'ListItem', position: 2, name: 'About Prime Estores', item: pageUrl },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(sobreSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<Layout
  title="About Prime Estores — Blinds Specialists in Lisbon"
  description="Get to know Prime Estores: our story, team, values and commitment to quality in the installation and repair of electric and manual blinds in Lisbon since 2015."
  keywords="about Prime Estores, blinds company Lisbon, who we are Prime Estores, certified blind installers Lisbon"
  canonicalURL={pageUrl}
  lang="en"
>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-[#1A1A1A] to-[#8B1A1A] text-white py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 text-sm text-white/80">
          <li><a href="/en/" class="hover:text-white transition-colors">Home</a></li>
          <li aria-hidden="true"><span>/</span></li>
          <li><span class="text-white">About Us</span></li>
        </ol>
      </nav>
      <div class="max-w-3xl">
        <span class="inline-block bg-white/10 border border-white/20 text-white text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full mb-4">Our Company</span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black leading-tight mb-4">
          About Prime Estores
        </h1>
        <p class="text-xl text-white/80 leading-relaxed">
          We have been specialists in electric and manual blinds in Lisbon for over a decade. We install quality, durability and comfort in every project.
        </p>
      </div>
    </div>
  </section>

  <!-- Our Story -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <span class="text-[#8B1A1A] text-sm font-semibold uppercase tracking-widest mb-3 block">Our Story</span>
          <h2 class="text-2xl lg:text-3xl font-black text-[#1A1A1A] mb-6">
            More than a decade serving Lisbon
          </h2>
          <p class="text-gray-600 leading-relaxed mb-4">
            Prime Estores was born in 2015 out of a passion for quality shading systems and the conviction that Lisbon deserved a truly professional blind installation service — punctual, transparent and with a real guarantee.
          </p>
          <p class="text-gray-600 leading-relaxed mb-4">
            We started with a small team focused on the city of Lisbon. Over the years, we grew organically thanks to our customers' satisfaction and their recommendations. Today we cover the whole of Greater Lisbon, from Mafra to Setúbal, serving hundreds of customers a year — private individuals, businesses and condominiums.
          </p>
          <p class="text-gray-600 leading-relaxed mb-6">
            What has not changed since day one: our commitment to the quality of the materials we install, the ongoing training of our team and total transparency in our quotes. We never charge for surprises.
          </p>
          <div class="grid grid-cols-3 gap-6">
            {[
              { numero: '10+', label: 'Years of experience' },
              { numero: '2000+', label: 'Completed installations' },
              { numero: '98%', label: 'Satisfied customers' },
            ].map(stat => (
              <div class="text-center">
                <div class="text-3xl font-black text-[#8B1A1A] mb-1">{stat.numero}</div>
                <div class="text-gray-500 text-xs leading-tight">{stat.label}</div>
              </div>
            ))}
          </div>
        </div>
        <div class="bg-[#F5F5F5] rounded-3xl p-8">
          <h3 class="text-xl font-black text-[#1A1A1A] mb-6">Our values</h3>
          <div class="space-y-5">
            {[
              {
                title: 'Transparency',
                desc: 'We provide detailed quotes with no small print. The price we agree on is the price you pay.',
                icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>',
              },
              {
                title: 'Uncompromising quality',
                desc: 'We use only materials and motors from recognised manufacturers — Somfy, Nice, Rollease — with a parts guarantee.',
                icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>',
              },
              {
                title: 'Punctuality',
                desc: 'We respect your time. We arrive at the agreed time and complete the work within the estimated timeframe.',
                icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>',
              },
              {
                title: 'After-sales service',
                desc: 'Our relationship does not end with the installation. We remain available for adjustment, repair and maintenance throughout the life of the product.',
                icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/>',
              },
            ].map(item => (
              <div class="flex gap-4">
                <div class="w-10 h-10 bg-[#8B1A1A] rounded-xl flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <Fragment set:html={item.icon} />
                  </svg>
                </div>
                <div>
                  <div class="font-semibold text-[#1A1A1A] mb-0.5">{item.title}</div>
                  <p class="text-gray-500 text-sm leading-relaxed">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Team -->
  <section class="py-16 lg:py-20 bg-[#F5F5F5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-12">
        <span class="text-[#8B1A1A] text-sm font-semibold uppercase tracking-widest mb-3 block">Who we are</span>
        <h2 class="text-2xl lg:text-3xl font-black text-[#1A1A1A] mb-4">Our team</h2>
        <p class="text-gray-600 leading-relaxed">
          Prime Estores is made up of specialised technicians with certified training in the installation of electric shading systems and home automation. All our installers are direct employees — we never subcontract the installation.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {[
          {
            area: 'Electrical Installation',
            desc: 'Technicians certified in the installation of Somfy, Nice and Rollease motors, and integration with home automation systems (KNX, Z-Wave, Zigbee).',
            icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>',
          },
          {
            area: 'Repair and Maintenance',
            desc: 'Technicians specialised in diagnosing and repairing any brand or model of electric or manual blind, with a stock of parts for immediate intervention.',
            icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>',
          },
          {
            area: 'Consultancy and Design',
            desc: 'Specialists in advising on shading projects for renovation works, condominiums and commercial spaces — from technical specification to final installation.',
            icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>',
          },
        ].map(item => (
          <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
            <div class="w-12 h-12 bg-[#8B1A1A] rounded-xl flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <Fragment set:html={item.icon} />
              </svg>
            </div>
            <h3 class="font-bold text-[#1A1A1A] mb-2">{item.area}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Brands and Certifications -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-10">
        <h2 class="text-2xl font-black text-[#1A1A1A] mb-4">Brands and partners</h2>
        <p class="text-gray-600 leading-relaxed">
          We work with the market-leading brands, ensuring quality and long-term parts availability.
        </p>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-6">
        {[
          { nome: 'Somfy', desc: 'World leader in motors for blinds and shutters. io-homecontrol and RTS protocol.' },
          { nome: 'Nice', desc: 'Italian manufacturer of automation solutions. Quiet and reliable motors.' },
          { nome: 'Rollease Acmeda', desc: 'High-precision roller systems for residential and commercial installations.' },
          { nome: 'Bubendorff', desc: 'High energy-performance exterior blinds, with European energy certification.' },
        ].map(marca => (
          <div class="bg-[#F5F5F5] rounded-2xl p-5 text-center">
            <div class="font-black text-[#1A1A1A] text-lg mb-2">{marca.nome}</div>
            <p class="text-gray-500 text-xs leading-relaxed">{marca.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Coverage Area -->
  <section class="py-16 bg-[#F5F5F5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-[#8B1A1A] text-sm font-semibold uppercase tracking-widest mb-3 block">Where we work</span>
          <h2 class="text-2xl lg:text-3xl font-black text-[#1A1A1A] mb-6">All of Greater Lisbon and beyond</h2>
          <p class="text-gray-600 leading-relaxed mb-4">
            Our coverage area spans the whole of Greater Lisbon — from the historic centre of the capital to the neighbouring municipalities. We travel to any point in this area with free call-out across most of Greater Lisbon.
          </p>
          <p class="text-gray-600 leading-relaxed mb-6">
            For larger projects (condominiums, businesses, renovation works), we assess travel outside Greater Lisbon on a case-by-case basis. Contact us to check coverage in your area.
          </p>
          <a href="/en/coverage-areas/" class="inline-flex items-center gap-2 text-[#8B1A1A] font-semibold hover:underline">
            See all the areas we serve →
          </a>
        </div>
        <div class="flex flex-wrap gap-2">
          {['Lisbon', 'Sintra', 'Cascais', 'Oeiras', 'Almada', 'Setúbal', 'Amadora', 'Loures', 'Odivelas', 'Mafra', 'Sesimbra', 'Palmela', 'Barreiro', 'Seixal'].map(zona => (
            <span class="bg-white border border-gray-200 text-gray-700 text-sm font-medium px-4 py-2 rounded-full shadow-sm">
              {zona}
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-[#1A1A1A] text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl lg:text-3xl font-black mb-4">
        Ready to work with us?
      </h2>
      <p class="text-gray-400 text-lg mb-8 max-w-2xl mx-auto">
        Request your free quote. We reply in under 24 hours.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/en/quote/" class="inline-flex items-center justify-center gap-2 bg-[#8B1A1A] text-white font-bold px-8 py-4 rounded-lg hover:bg-[#7a1717] transition-colors">
          Get a Free Quote
        </a>
        <a href="/en/contact/" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white font-bold px-8 py-4 rounded-lg hover:bg-white/10 transition-colors">
          Talk to Our Team
        </a>
      </div>
    </div>
  </section>

</Layout>
