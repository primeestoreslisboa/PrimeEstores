---
import Layout from '../../layouts/Layout.astro';
import HelpfulContent from '../../components/HelpfulContent.astro';
import { useTranslations } from '../../i18n/utils';

const lang = 'en' as const;
const t = useTranslations(lang);

const zones = [
  { name: 'Lisbon', slug: 'lisboa', desc: 'We serve all neighborhoods and parishes of Lisbon, from Alfama and Mouraria to Parque das Nações, Belém, Alvalade and all others. The capital is our main area of operation.' },
  { name: 'Sintra', slug: 'sintra', desc: 'We cover the entire municipality of Sintra, including Sintra Vila, Rio de Mouro, Agualva-Cacém, Algueirão-Mem Martins, Queluz, Massamá and Belas.' },
  { name: 'Cascais', slug: 'cascais', desc: 'We serve the entire municipality of Cascais, including Cascais centre, Estoril, Parede, Carcavelos, São Domingos de Rana and Alcabideche.' },
  { name: 'Oeiras', slug: 'oeiras', desc: 'We serve the entire municipality of Oeiras, including Oeiras centre, Porto Salvo, Barcarena, Carnaxide, Linda-a-Velha, Algés and Cruz Quebrada.' },
  { name: 'Almada', slug: 'almada', desc: 'We cover Almada and all its localities, including Costa da Caparica, Trafaria, Cacilhas, Almada Velha, Cova da Piedade and Laranjeiro.' },
  { name: 'Setúbal', slug: 'setubal', desc: 'We serve the municipality of Setúbal and surroundings, including the city of Setúbal and areas such as Azeitão, São Bernardo and Sado.' },
  { name: 'Amadora', slug: 'amadora', desc: 'We cover the entire municipality of Amadora, including Alfornelos, Brandoa, Damaia, Falagueira, Mina de Água, Reboleira and Venteira.' },
  { name: 'Loures', slug: 'loures', desc: 'We serve the municipality of Loures, including Loures centre, Sacavém, Santa Iria de Azóia, Moscavide, Prior Velho and surroundings.' },
  { name: 'Odivelas', slug: 'odivelas', desc: 'We cover the entire municipality of Odivelas, including Odivelas centre, Pontinha, Famões, Póvoa de Santo Adrião and Ramada.' },
  { name: 'Vila Franca de Xira', slug: 'vila-franca-de-xira', desc: 'We serve Vila Franca de Xira and its entire municipality, including Alverca do Ribatejo, Vialonga, Sobralinho and Forte da Casa.' },
  { name: 'Mafra', slug: 'mafra', desc: 'We cover the municipality of Mafra, including Mafra centre, Ericeira, Malveira, Cheleiros and other localities.' },
  { name: 'Sesimbra', slug: 'sesimbra', desc: 'We serve Sesimbra and its municipality, including Sesimbra centre, Santana, Cotovia and Quinta do Conde.' },
  { name: 'Palmela', slug: 'palmela', desc: 'We serve the municipality of Palmela, including Palmela centre, Pinhal Novo and Quinta do Anjo, with electric and manual blind installation and repair.' },
];
---

<Layout
  title="Coverage Areas | Prime Estores - Greater Lisbon"
  description="Blind installation and repair across Greater Lisbon: Lisbon, Sintra, Cascais, Oeiras, Almada, Setúbal, Amadora, Loures, Odivelas and more. Free quote."
  lang={lang}
>
  <section class="bg-gradient-to-br from-[#1A1A1A] to-[#8B1A1A] text-white py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 text-sm text-white/80">
          <li><a href="/en/" class="hover:text-white transition-colors">Home</a></li>
          <li aria-hidden="true"><span>/</span></li>
          <li><span class="text-white">Coverage Areas</span></li>
        </ol>
      </nav>
      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black leading-tight mb-4">{t('zones.title')}</h1>
        <p class="text-xl text-white/80 leading-relaxed">{t('zones.subtitle')}</p>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-[#F5F5F5]" aria-labelledby="zones-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 id="zones-heading" class="sr-only">Municipalities we serve</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {zones.map(zone => (
          <article id={zone.slug} class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 hover:shadow-md transition-shadow scroll-mt-24">
            <div class="flex items-start gap-3 mb-3">
              <div class="w-8 h-8 bg-[#8B1A1A] rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <h3 class="text-xl font-black text-[#1A1A1A]">{zone.name}</h3>
            </div>
            <p class="text-gray-600 text-sm leading-relaxed mb-4">{zone.desc}</p>
            <a href={`/en/coverage-areas/${zone.slug}`} class="inline-flex items-center gap-1 text-[#8B1A1A] font-semibold text-sm hover:gap-2 transition-all hover:underline">
              Blind services in {zone.name}
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-[#8B1A1A] text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-black mb-4">Don't see your area?</h2>
      <p class="text-red-100 text-lg mb-8">Contact us to check availability. We try to reach any point in the Lisbon metropolitan area.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/en/quote" class="inline-flex items-center justify-center gap-2 bg-white text-[#8B1A1A] font-bold px-8 py-4 rounded-lg hover:bg-gray-100 transition-colors">Get Free Quote</a>
        <a href="tel:+351923348323" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white font-bold px-8 py-4 rounded-lg hover:bg-white/10 transition-colors">+351 923 348 323</a>
      </div>
    </div>
  </section>
  <HelpfulContent lang={lang} page="coverage" />
</Layout>
