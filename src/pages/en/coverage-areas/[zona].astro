---
import Layout from '../../../layouts/Layout.astro';
import { zonas } from '../../../data/zonaData';
import { zonaEn } from '../../../data/zonasEn';
import { servicosMatrizEn } from '../../../data/servicosMatrizEn';

// English per-zona hub. Mirrors the PT /zonas/[zona] page.
export function getStaticPaths() {
  return zonas.map(zona => ({ params: { zona: zona.slug }, props: { zona } }));
}

interface ZonaProp { nome: string; slug: string; bairros: string[]; geo: { lat: number; lng: number }; }
const { zona } = Astro.props as { zona: ZonaProp };
const en = zonaEn[zona.slug];

const baseUrl = 'https://primeestores.pt';
const pageUrl = `${baseUrl}/en/coverage-areas/${zona.slug}/`;

const icons: Record<string, string> = {
  'electric-blinds': `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>`,
  'manual-blinds': `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/>`,
  'blind-repair': `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 112.83-2.83l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 112.83 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/>`,
  'electrical-work': `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>`,
};

const schemaLocalBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${baseUrl}/#business`,
  name: 'Prime Estores',
  url: baseUrl,
  telephone: '+351923348323',
  email: 'info@primeestores.pt',
  image: `${baseUrl}/og-image.jpg`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Lisbon',
    addressRegion: 'Lisbon',
    addressCountry: 'PT',
  },
  areaServed: { '@type': 'City', name: zona.nome },
  geo: { '@type': 'GeoCoordinates', latitude: zona.geo.lat, longitude: zona.geo.lng },
  priceRange: '€€',
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
    opens: '08:00',
    closes: '20:00',
  }],
};

const schemaBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${baseUrl}/en/` },
    { '@type': 'ListItem', position: 2, name: 'Coverage Areas', item: `${baseUrl}/en/coverage-areas/` },
    { '@type': 'ListItem', position: 3, name: zona.nome, item: pageUrl },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schemaLocalBusiness)} />
<script type="application/ld+json" set:html={JSON.stringify(schemaBreadcrumb)} />

<Layout
  lang="en"
  title={`Blinds in ${zona.nome} — Installation & Repair | Prime Estores`}
  description={en.description}
  keywords={en.keywords}
  canonicalURL={pageUrl}
>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-[#1A1A1A] to-[#8B1A1A] text-white py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex flex-wrap items-center gap-2 text-sm text-white/80">
          <li><a href="/en/" class="hover:text-white transition-colors">Home</a></li>
          <li aria-hidden="true"><span>/</span></li>
          <li><a href="/en/coverage-areas" class="hover:text-white transition-colors">Coverage Areas</a></li>
          <li aria-hidden="true"><span>/</span></li>
          <li><span class="text-white">{zona.nome}</span></li>
        </ol>
      </nav>
      <div class="max-w-3xl">
        <span class="inline-block bg-white/10 border border-white/20 text-white text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full mb-4">Service Area</span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black leading-tight mb-4">
          Blinds in {zona.nome}<br class="hidden sm:block" /> — Installation & Repair
        </h1>
        <p class="text-xl text-white/80 leading-relaxed mb-8">{en.intro}</p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/en/quote" class="inline-flex items-center justify-center gap-2 bg-white text-[#8B1A1A] font-bold px-6 py-3.5 rounded-lg hover:bg-gray-100 transition-colors">
            Get a Free Quote
          </a>
          <a href="tel:+351923348323" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white font-bold px-6 py-3.5 rounded-lg hover:bg-white/10 transition-colors">
            +351 923 348 323
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Content -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-12">

        <div class="lg:col-span-2 space-y-8">
          <div>
            <h2 class="text-2xl lg:text-3xl font-black text-[#1A1A1A] mb-4">Blind services in {zona.nome}</h2>
            <p class="text-gray-600 leading-relaxed mb-4">{en.intro}</p>
            <p class="text-gray-600 leading-relaxed">{en.detail}</p>
          </div>

          <div>
            <h2 class="text-xl font-black text-[#1A1A1A] mb-4">Areas and localities covered in {zona.nome}</h2>
            <div class="flex flex-wrap gap-2">
              {zona.bairros.map(b => (
                <span class="bg-[#F5F5F5] text-gray-700 text-sm font-medium px-3 py-1.5 rounded-full border border-gray-200">{b}</span>
              ))}
            </div>
          </div>

          <div>
            <h2 class="text-xl font-black text-[#1A1A1A] mb-4">Why choose Prime Estores in {zona.nome}?</h2>
            <div class="grid sm:grid-cols-2 gap-4">
              {[
                { title: 'Fast response', desc: `Technicians available in ${zona.nome} Mon–Sat, 8am–8pm.` },
                { title: 'Free quote', desc: 'We travel to assess the work at no cost.' },
                { title: 'Certified technicians', desc: 'Experienced installers with certified technical training in electric blind systems and home automation.' },
                { title: '1-year warranty', desc: 'All installation work has a minimum 1-year warranty.' },
              ].map(item => (
                <div class="flex gap-3 p-4 bg-[#F5F5F5] rounded-xl">
                  <svg class="w-5 h-5 text-[#8B1A1A] flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  <div>
                    <div class="font-semibold text-[#1A1A1A] text-sm">{item.title}</div>
                    <div class="text-gray-500 text-xs mt-0.5">{item.desc}</div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <div class="space-y-6">
          <div class="bg-[#8B1A1A] rounded-2xl p-6 text-white">
            <h3 class="font-black text-lg mb-2">Get a quote in {zona.nome}</h3>
            <p class="text-red-100 text-sm mb-5 leading-relaxed">Contact us now for a free, no-obligation quote.</p>
            <a href="/en/quote" class="block w-full text-center bg-white text-[#8B1A1A] font-bold px-4 py-3 rounded-lg hover:bg-gray-100 transition-colors mb-3">Quote form</a>
            <a href="tel:+351923348323" class="block w-full text-center border-2 border-white text-white font-bold px-4 py-3 rounded-lg hover:bg-white/10 transition-colors text-sm">+351 923 348 323</a>
          </div>
          <div class="bg-white rounded-2xl p-6 border border-gray-100">
            <h3 class="font-bold text-[#1A1A1A] mb-3 text-sm uppercase tracking-wide">Other areas</h3>
            <a href="/en/coverage-areas" class="text-[#8B1A1A] text-sm font-semibold hover:underline">See all areas →</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="py-16 bg-[#F5F5F5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl lg:text-3xl font-black text-[#1A1A1A] mb-8 text-center">Our services in {zona.nome}</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {servicosMatrizEn.map(s => (
          <a
            href={`/en/coverage-areas/${zona.slug}/${s.slug}`}
            class="group bg-white rounded-2xl p-6 shadow-sm border border-gray-100 hover:border-[#8B1A1A] hover:shadow-md transition-all flex flex-col"
          >
            <div class="w-10 h-10 bg-[#8B1A1A] rounded-xl flex items-center justify-center mb-4 flex-shrink-0">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <Fragment set:html={icons[s.slug]} />
              </svg>
            </div>
            <div class="font-bold text-[#1A1A1A] mb-2 group-hover:text-[#8B1A1A] transition-colors">{s.nome}</div>
            <p class="text-gray-500 text-sm leading-relaxed flex-1">{s.description(zona.nome)}</p>
            <span class="mt-4 text-[#8B1A1A] text-sm font-semibold group-hover:underline">{s.nome} in {zona.nome} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-[#1A1A1A] text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl lg:text-3xl font-black mb-4">Need blinds in {zona.nome}?</h2>
      <p class="text-gray-400 text-lg mb-8 max-w-2xl mx-auto">
        Contact us today for a free quote. We travel to {zona.nome} and surrounding areas Monday to Saturday from 8am to 8pm.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/en/quote" class="inline-flex items-center justify-center gap-2 bg-[#8B1A1A] text-white font-bold px-8 py-4 rounded-lg hover:bg-[#7a1717] transition-colors">
          Get a Free Quote
        </a>
        <a href="tel:+351923348323" class="inline-flex items-center justify-center gap-2 border-2 border-white/30 text-white font-bold px-8 py-4 rounded-lg hover:bg-white/10 transition-colors">
          +351 923 348 323
        </a>
      </div>
    </div>
  </section>

</Layout>
