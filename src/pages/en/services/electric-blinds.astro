---
import Layout from '../../../layouts/Layout.astro';
import ContactForm from '../../../components/ContactForm.astro';
import ServiceExtras from '../../../components/ServiceExtras.astro';
import RelatedServices from '../../../components/RelatedServices.astro';
import { useTranslations } from '../../../i18n/utils';

const lang = 'en' as const;
const t = useTranslations(lang);
---

<Layout
  title="Electric Blind Installation & Repair in Lisbon | Prime Estores"
  description="Professional installation and repair of electric and motorized blinds in Lisbon and Greater Lisbon. Remote control, app or smart home compatible. Free quote."
  schemaType="Service"
  serviceName="Electric Blind Installation in Lisbon"
  serviceDescription="Professional installation and repair of electric and motorized blinds in Lisbon and Greater Lisbon."
  lang={lang}
>
  <section class="bg-gradient-to-br from-[#1A1A1A] to-[#8B1A1A] text-white py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 text-sm text-white/80">
          <li><a href="/en/" class="hover:text-white transition-colors">Home</a></li>
          <li aria-hidden="true"><span>/</span></li>
          <li><span class="text-white">Electric Blinds</span></li>
        </ol>
      </nav>
      <div class="max-w-3xl">
        <span class="inline-block bg-white/10 border border-white/20 text-white text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full mb-4">Service</span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black leading-tight mb-4">{t('service.electric.h1')}</h1>
        <p class="text-xl text-white/80 leading-relaxed mb-8">Comfort and modernity at the touch of a button. We install motorized electric blinds throughout Greater Lisbon with guaranteed quality.</p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/en/quote" class="inline-flex items-center justify-center gap-2 bg-white text-[#8B1A1A] font-bold px-6 py-3.5 rounded-lg hover:bg-gray-100 transition-colors">Get Free Quote</a>
          <a href="tel:+351923348323" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white font-bold px-6 py-3.5 rounded-lg hover:bg-white/10 transition-colors">+351 923 348 323</a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-12">
        <div class="lg:col-span-2">
          <h2 class="text-2xl lg:text-3xl font-black text-[#1A1A1A] mb-4">What are electric blinds?</h2>
          <p class="text-gray-600 leading-relaxed mb-6">Electric blinds, also known as motorized blinds, are shading systems that operate through an electric motor. They are controlled by remote control, wall switch or home automation systems, offering maximum comfort without any physical effort.</p>
          <p class="text-gray-600 leading-relaxed mb-6">At Prime Estores, we install electric blinds with high-quality motors in homes and businesses throughout Greater Lisbon. Each installation is carried out with technical precision, ensuring silent and long-lasting operation.</p>

          <h2 class="text-2xl font-black text-[#1A1A1A] mb-4 mt-8">Advantages of electric blinds</h2>
          <div class="grid sm:grid-cols-2 gap-4 mb-8">
            {[
              { title: 'Maximum comfort', desc: 'Remote control without physical effort' },
              { title: 'Smart home compatible', desc: 'Integration with Google Home, Alexa and other systems' },
              { title: 'Automatic scheduling', desc: 'Set automatic opening and closing times' },
              { title: 'Security', desc: 'Simulate presence at home when you are away' },
              { title: 'Energy efficiency', desc: 'Reduces heat entry and saves on air conditioning' },
              { title: 'Durability', desc: 'Long-lasting motors with 2 year warranty' },
            ].map(item => (
              <div class="flex gap-3 p-4 bg-[#F5F5F5] rounded-xl">
                <svg class="w-5 h-5 text-[#8B1A1A] flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                <div>
                  <div class="font-semibold text-[#1A1A1A] text-sm">{item.title}</div>
                  <div class="text-gray-500 text-xs mt-0.5">{item.desc}</div>
                </div>
              </div>
            ))}
          </div>

          <h2 class="text-2xl font-black text-[#1A1A1A] mb-4 mt-8">Coverage areas</h2>
          <p class="text-gray-600 leading-relaxed mb-4">We install electric blinds throughout <strong>Greater Lisbon</strong>, including: Lisbon (all neighborhoods), Sintra, Cascais, Oeiras, Almada, Setúbal, Amadora, Loures, Odivelas and more.</p>
          <a href="/en/coverage-areas" class="text-[#8B1A1A] font-semibold hover:underline text-sm">See all coverage areas →</a>
        </div>
        <div class="space-y-6">
          <ContactForm showTitle={true} lang={lang} />
          <div class="bg-[#F5F5F5] rounded-2xl p-6">
            <h3 class="font-bold text-[#1A1A1A] mb-4">Useful information</h3>
            <div class="space-y-3 text-sm">
              {['Response within 24h', '2 year warranty', '100% free quote', 'Certified technicians'].map(item => (
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-[#8B1A1A]" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  <span class="text-gray-600">{item}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <ServiceExtras service="electric" lang={lang} />
  <RelatedServices current="electric" lang={lang} />
</Layout>
