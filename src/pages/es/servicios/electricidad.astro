---
import Layout from '../../../layouts/Layout.astro';
import ContactForm from '../../../components/ContactForm.astro';
import ServiceExtras from '../../../components/ServiceExtras.astro';

const lang = 'es' as const;
---

<Layout
  title="Instalación Eléctrica en Lisboa | Prime Estores"
  description="Instalación de enchufes, interruptores, lámparas e iluminación LED en Lisboa y Gran Lisboa. Servicio rápido con técnicos certificados. Presupuesto gratis."
  keywords="instalación eléctrica Lisboa, enchufes Lisboa, interruptores Lisboa, lámparas Lisboa, iluminación LED Lisboa, electricista Lisboa"
  schemaType="Service"
  serviceName="Instalación Eléctrica en Lisboa"
  serviceDescription="Instalación de enchufes, interruptores, lámparas e iluminación LED en Lisboa y Gran Lisboa. Técnicos certificados con garantía de 1 año."
  lang={lang}
>

  <!-- Page Hero -->
  <section class="bg-gradient-to-br from-[#1A1A1A] to-[#8B1A1A] text-white py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 text-sm text-white/60">
          <li><a href="/es/" class="hover:text-white transition-colors">Inicio</a></li>
          <li aria-hidden="true"><span>/</span></li>
          <li><span class="text-white">Electricidad</span></li>
        </ol>
      </nav>
      <div class="max-w-3xl">
        <span class="inline-block bg-white/10 border border-white/20 text-white text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full mb-4">Servicio</span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black leading-tight mb-4">
          Instalación Eléctrica en Lisboa
        </h1>
        <p class="text-xl text-white/80 leading-relaxed mb-8">
          Enchufes, interruptores, lámparas e iluminación LED. Servicio rápido con técnicos certificados en todo el Gran Lisboa.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/es/presupuesto" class="inline-flex items-center justify-center gap-2 bg-white text-[#8B1A1A] font-bold px-6 py-3.5 rounded-lg hover:bg-gray-100 transition-colors">
            Pedir Presupuesto Gratis
          </a>
          <a href="tel:+351923348323" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white font-bold px-6 py-3.5 rounded-lg hover:bg-white/10 transition-colors">
            +351 923 348 323
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Main content -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-12">

        <!-- Content -->
        <div class="lg:col-span-2">
          <h2 class="text-2xl lg:text-3xl font-black text-[#1A1A1A] mb-4">Lo que hacemos</h2>
          <p class="text-gray-600 leading-relaxed mb-6">
            En Prime Estores realizamos trabajos de electricidad para viviendas y empresas en todo el Gran Lisboa. Desde la instalación de enchufes e interruptores hasta la colocación de lámparas y sistemas de iluminación LED — lo hacemos todo con rigor, rapidez y garantía incluida.
          </p>
          <p class="text-gray-600 leading-relaxed mb-6">
            Todos los trabajos son ejecutados por técnicos certificados, con materiales de calidad y cumpliendo las normas de seguridad eléctrica vigentes. Sin suciedad, sin daños en paredes, sin sorpresas al final.
          </p>

          <h2 class="text-2xl font-black text-[#1A1A1A] mb-4 mt-8">Lo que incluimos</h2>
          <div class="grid sm:grid-cols-2 gap-4 mb-8">
            {[
              { title: 'Instalación de enchufes', desc: 'Enchufes simples, dobles, triples y con cargador USB integrado' },
              { title: 'Instalación de interruptores', desc: 'Interruptores simples, conmutadores y reguladores de intensidad (dimmer)' },
              { title: 'Colocación de lámparas', desc: 'Lámparas de techo, apliques de pared y colgantes decorativos' },
              { title: 'Iluminación LED', desc: 'Focos empotrables, tiras LED, paneles LED y apliques de bajo consumo' },
              { title: 'Trabajo rápido y limpio', desc: 'Sin daños en paredes ni acabados — dejamos todo como lo encontramos' },
              { title: 'Garantía de 1 año', desc: 'Todos los trabajos eléctricos realizados tienen garantía de 1 año incluida' },
            ].map(item => (
              <div class="flex gap-3 p-4 bg-[#F5F5F5] rounded-xl">
                <svg class="w-5 h-5 text-[#8B1A1A] flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                <div>
                  <div class="font-semibold text-[#1A1A1A] text-sm">{item.title}</div>
                  <div class="text-gray-500 text-xs mt-0.5">{item.desc}</div>
                </div>
              </div>
            ))}
          </div>

          <h2 class="text-2xl font-black text-[#1A1A1A] mb-4 mt-8">Cómo funciona nuestro proceso</h2>
          <ol class="space-y-4 mb-8">
            {[
              { step: '01', title: 'Contacto y presupuesto gratuito', desc: 'Contáctenos por teléfono o formulario. Evaluamos el trabajo y presentamos presupuesto sin compromiso.' },
              { step: '02', title: 'Evaluación en el lugar', desc: 'En casos más complejos, nos desplazamos para evaluar la instalación existente y planificar el trabajo.' },
              { step: '03', title: 'Programación', desc: 'Fijamos la fecha y hora más conveniente para usted. Garantizamos puntualidad.' },
              { step: '04', title: 'Ejecución profesional', desc: 'Nuestros técnicos realizan el trabajo de forma rápida, limpia y segura, cumpliendo todas las normas eléctricas.' },
              { step: '05', title: 'Entrega y garantía', desc: 'Comprobamos todo antes de irnos y entregamos el servicio con garantía de 1 año incluida.' },
            ].map(item => (
              <li class="flex gap-4">
                <div class="flex-shrink-0 w-10 h-10 bg-[#8B1A1A] text-white rounded-full flex items-center justify-center font-black text-sm">
                  {item.step}
                </div>
                <div>
                  <div class="font-semibold text-[#1A1A1A]">{item.title}</div>
                  <div class="text-gray-500 text-sm mt-0.5">{item.desc}</div>
                </div>
              </li>
            ))}
          </ol>

          <h2 class="text-2xl font-black text-[#1A1A1A] mb-4 mt-8">Zonas de cobertura</h2>
          <p class="text-gray-600 leading-relaxed mb-4">
            Prestamos servicios eléctricos en todo el <strong>Gran Lisboa</strong>, incluyendo: Lisboa (todos los barrios), Sintra, Cascais, Oeiras, Almada, Setúbal, Amadora, Loures, Odivelas, Vila Franca de Xira, Mafra, Sesimbra y Palmela.
          </p>
          <a href="/es/zonas-cobertura" class="text-[#8B1A1A] font-semibold hover:underline text-sm">
            Ver todas las zonas que cubrimos →
          </a>
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
          <ContactForm showTitle={true} lang={lang} />
          <div class="bg-[#F5F5F5] rounded-2xl p-6">
            <h3 class="font-bold text-[#1A1A1A] mb-4">Información útil</h3>
            <div class="space-y-3 text-sm">
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-[#8B1A1A]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <span class="text-gray-600">Respuesta en menos de 24h</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-[#8B1A1A]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
                <span class="text-gray-600">Garantía de 1 año</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-[#8B1A1A]" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                <span class="text-gray-600">Presupuesto 100% gratuito</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-[#8B1A1A]" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                <span class="text-gray-600">Técnicos certificados</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <ServiceExtras service="electrical" lang={lang} />
</Layout>
