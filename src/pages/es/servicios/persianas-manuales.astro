---
import Layout from '../../../layouts/Layout.astro';
import ContactForm from '../../../components/ContactForm.astro';
import ServiceExtras from '../../../components/ServiceExtras.astro';
import RelatedServices from '../../../components/RelatedServices.astro';
import { useTranslations } from '../../../i18n/utils';

const lang = 'es' as const;
const t = useTranslations(lang);
---

<Layout
  title="Persianas Manuales - Instalación y Reparación en Lisboa | Prime Estores"
  description="Instalación de persianas manuales de calidad en Lisboa y Gran Lisboa. Presupuesto gratuito."
  schemaType="Service"
  lang={lang}
>
  <section class="bg-gradient-to-br from-[#1A1A1A] to-[#8B1A1A] text-white py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 text-sm text-white/80">
          <li><a href="/es/" class="hover:text-white transition-colors">Inicio</a></li>
          <li aria-hidden="true"><span>/</span></li>
          <li><span class="text-white">Persianas Manuales</span></li>
        </ol>
      </nav>
      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black leading-tight mb-4">{t('service.manual.h1')}</h1>
        <p class="text-xl text-white/80 leading-relaxed mb-8">Soluciones prácticas y económicas para cualquier habitación. Instalamos persianas manuales de calidad en todo el Gran Lisboa.</p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/es/presupuesto" class="inline-flex items-center justify-center gap-2 bg-white text-[#8B1A1A] font-bold px-6 py-3.5 rounded-lg hover:bg-gray-100 transition-colors">{t('hero.cta.quote')}</a>
          <a href="tel:+351923348323" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white font-bold px-6 py-3.5 rounded-lg hover:bg-white/10 transition-colors">+351 923 348 323</a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-12">
        <div class="lg:col-span-2">
          <h2 class="text-2xl lg:text-3xl font-black text-[#1A1A1A] mb-4">Persianas manuales: calidad y practicidad</h2>
          <p class="text-gray-600 leading-relaxed mb-6">Las persianas manuales siguen siendo la solución más popular para el control de la luz y la privacidad. Económicas, fáciles de operar y con poco mantenimiento.</p>
          <a href="/es/zonas-cobertura" class="text-[#8B1A1A] font-semibold hover:underline text-sm">Ver todas las zonas de cobertura →</a>
        </div>
        <div class="space-y-6">
          <ContactForm showTitle={true} lang={lang} />
        </div>
      </div>
    </div>
  </section>
  <ServiceExtras service="manual" lang={lang} />
  <RelatedServices current="manual" lang={lang} />
</Layout>
