---
import Layout from '../../../layouts/Layout.astro';
import ContactForm from '../../../components/ContactForm.astro';
import ServiceExtras from '../../../components/ServiceExtras.astro';
import RelatedServices from '../../../components/RelatedServices.astro';
import { useTranslations } from '../../../i18n/utils';

const lang = 'es' as const;
const t = useTranslations(lang);
---

<Layout
  title="Reparación de Persianas en Lisboa | Prime Estores"
  description="Reparación urgente de persianas eléctricas y manuales en Lisboa y Gran Lisboa. Diagnóstico gratuito, técnicos certificados."
  schemaType="Service"
  lang={lang}
>
  <section class="bg-gradient-to-br from-[#1A1A1A] to-[#8B1A1A] text-white py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 text-sm text-white/80">
          <li><a href="/es/" class="hover:text-white transition-colors">Inicio</a></li>
          <li aria-hidden="true"><span>/</span></li>
          <li><span class="text-white">Reparación de Persianas</span></li>
        </ol>
      </nav>
      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black leading-tight mb-4">{t('service.repair.h1')}</h1>
        <p class="text-xl text-white/80 leading-relaxed mb-8">¿Su persiana se ha averiado? Diagnóstico gratuito, intervención rápida y piezas originales.</p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="tel:+351923348323" class="inline-flex items-center justify-center gap-2 bg-white text-[#8B1A1A] font-bold px-6 py-3.5 rounded-lg hover:bg-gray-100 transition-colors">Llamar: +351 923 348 323</a>
          <a href="/es/presupuesto" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white font-bold px-6 py-3.5 rounded-lg hover:bg-white/10 transition-colors">Solicitar Presupuesto</a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-12">
        <div class="lg:col-span-2">
          <h2 class="text-2xl lg:text-3xl font-black text-[#1A1A1A] mb-4">Reparación especializada de persianas</h2>
          <p class="text-gray-600 leading-relaxed mb-6">Las persianas pueden averiarse por múltiples razones: desgaste del motor eléctrico, muelles rotos, cuerdas dañadas o problemas mecánicos. En Prime Estores, diagnosticamos y reparamos todo tipo de averías.</p>
        </div>
        <div class="space-y-6">
          <div class="bg-[#8B1A1A] rounded-2xl p-6 text-white">
            <h3 class="font-black text-xl mb-2">¿Avería urgente?</h3>
            <p class="text-red-100 text-sm mb-4">Para situaciones urgentes, llame directamente.</p>
            <a href="tel:+351923348323" class="flex items-center justify-center gap-2 bg-white text-[#8B1A1A] font-bold px-4 py-3 rounded-lg hover:bg-gray-100 transition-colors text-sm w-full">+351 923 348 323</a>
          </div>
          <ContactForm showTitle={true} lang={lang} />
        </div>
      </div>
    </div>
  </section>
  <ServiceExtras service="repair" lang={lang} />
  <RelatedServices current="repair" lang={lang} />
</Layout>
