---
import Layout from '../../layouts/Layout.astro';

const baseUrl = 'https://primeestores.pt';
const pageUrl = `${baseUrl}/fr/a-propos/`;

const sobreSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${baseUrl}/#business`,
  name: 'Prime Estores',
  url: baseUrl,
  telephone: '+351923348323',
  email: 'info@primeestores.pt',
  image: `${baseUrl}/og-image.jpg`,
  description: 'Entreprise spécialisée dans l\'installation et la réparation de stores électriques et manuels à Lisbonne et dans le Grand Lisbonne depuis 2015.',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Lisbonne',
    addressRegion: 'Lisbonne',
    addressCountry: 'PT',
  },
  foundingDate: '2015',
  areaServed: { '@type': 'State', name: 'Grand Lisbonne' },
  priceRange: '€€',
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
    opens: '08:00',
    closes: '20:00',
  }],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${baseUrl}/fr/` },
    { '@type': 'ListItem', position: 2, name: 'À propos de Prime Estores', item: pageUrl },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(sobreSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<Layout
  title="À propos de Prime Estores — Spécialistes des stores à Lisbonne"
  description="Découvrez Prime Estores : notre histoire, notre équipe, nos valeurs et notre engagement envers la qualité dans l'installation et la réparation de stores électriques et manuels à Lisbonne depuis 2015."
  keywords="à propos Prime Estores, entreprise stores Lisbonne, qui sommes-nous Prime Estores, installateurs stores certifiés Lisbonne"
  canonicalURL={pageUrl}
  lang="fr"
>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-[#1A1A1A] to-[#8B1A1A] text-white py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 text-sm text-white/80">
          <li><a href="/fr/" class="hover:text-white transition-colors">Accueil</a></li>
          <li aria-hidden="true"><span>/</span></li>
          <li><span class="text-white">À propos</span></li>
        </ol>
      </nav>
      <div class="max-w-3xl">
        <span class="inline-block bg-white/10 border border-white/20 text-white text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full mb-4">Notre entreprise</span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black leading-tight mb-4">
          À propos de Prime Estores
        </h1>
        <p class="text-xl text-white/80 leading-relaxed">
          Nous sommes spécialistes des stores électriques et manuels à Lisbonne depuis plus de dix ans. Nous installons qualité, durabilité et confort dans chaque projet.
        </p>
      </div>
    </div>
  </section>

  <!-- Notre histoire -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <span class="text-[#8B1A1A] text-sm font-semibold uppercase tracking-widest mb-3 block">Notre histoire</span>
          <h2 class="text-2xl lg:text-3xl font-black text-[#1A1A1A] mb-6">
            Plus de dix ans au service de Lisbonne
          </h2>
          <p class="text-gray-600 leading-relaxed mb-4">
            Prime Estores est née en 2015 d'une passion pour les systèmes d'occultation de qualité et de la conviction que Lisbonne méritait un service d'installation de stores véritablement professionnel — ponctuel, transparent et avec une garantie réelle.
          </p>
          <p class="text-gray-600 leading-relaxed mb-4">
            Nous avons commencé avec une petite équipe centrée sur la ville de Lisbonne. Au fil des ans, nous avons grandi de manière organique grâce à la satisfaction de nos clients et à leurs recommandations. Aujourd'hui, nous couvrons tout le Grand Lisbonne, de Mafra à Setúbal, au service de centaines de clients par an — particuliers, entreprises et copropriétés.
          </p>
          <p class="text-gray-600 leading-relaxed mb-6">
            Ce qui n'a pas changé depuis le premier jour : notre engagement envers la qualité des matériaux que nous installons, la formation continue de notre équipe et une transparence totale dans nos devis. Nous ne facturons jamais de surprises.
          </p>
          <div class="grid grid-cols-3 gap-6">
            {[
              { numero: '10+', label: 'Années d\'expérience' },
              { numero: '2000+', label: 'Installations réalisées' },
              { numero: '98%', label: 'Clients satisfaits' },
            ].map(stat => (
              <div class="text-center">
                <div class="text-3xl font-black text-[#8B1A1A] mb-1">{stat.numero}</div>
                <div class="text-gray-500 text-xs leading-tight">{stat.label}</div>
              </div>
            ))}
          </div>
        </div>
        <div class="bg-[#F5F5F5] rounded-3xl p-8">
          <h3 class="text-xl font-black text-[#1A1A1A] mb-6">Nos valeurs</h3>
          <div class="space-y-5">
            {[
              {
                title: 'Transparence',
                desc: 'Nous présentons des devis détaillés, sans petites lignes. Le prix convenu est le prix que vous payez.',
                icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>',
              },
              {
                title: 'Qualité sans compromis',
                desc: 'Nous utilisons uniquement des matériaux et des moteurs de fabricants reconnus — Somfy, Nice, Rollease — avec garantie des pièces.',
                icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>',
              },
              {
                title: 'Ponctualité',
                desc: 'Nous respectons votre temps. Nous nous présentons à l\'heure convenue et terminons les travaux dans le délai estimé.',
                icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>',
              },
              {
                title: 'Service après-vente',
                desc: 'Notre relation ne s\'arrête pas à l\'installation. Nous restons disponibles pour le réglage, la réparation et l\'entretien pendant toute la durée de vie du produit.',
                icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/>',
              },
            ].map(item => (
              <div class="flex gap-4">
                <div class="w-10 h-10 bg-[#8B1A1A] rounded-xl flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <Fragment set:html={item.icon} />
                  </svg>
                </div>
                <div>
                  <div class="font-semibold text-[#1A1A1A] mb-0.5">{item.title}</div>
                  <p class="text-gray-500 text-sm leading-relaxed">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Notre équipe -->
  <section class="py-16 lg:py-20 bg-[#F5F5F5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-12">
        <span class="text-[#8B1A1A] text-sm font-semibold uppercase tracking-widest mb-3 block">Qui sommes-nous</span>
        <h2 class="text-2xl lg:text-3xl font-black text-[#1A1A1A] mb-4">Notre équipe</h2>
        <p class="text-gray-600 leading-relaxed">
          Prime Estores est composée de techniciens spécialisés, avec une formation certifiée en installation de systèmes d'occultation électriques et de domotique. Tous nos installateurs sont des employés directs — nous ne sous-traitons pas l'installation.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {[
          {
            area: 'Installation électrique',
            desc: 'Techniciens certifiés pour l\'installation de moteurs Somfy, Nice et Rollease, et l\'intégration avec des systèmes domotiques (KNX, Z-Wave, Zigbee).',
            icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>',
          },
          {
            area: 'Réparation et entretien',
            desc: 'Techniciens spécialisés dans le diagnostic et la réparation de toute marque ou modèle de store électrique ou manuel, avec un stock de pièces pour une intervention immédiate.',
            icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>',
          },
          {
            area: 'Conseil et projet',
            desc: 'Spécialistes du conseil pour les projets d\'occultation dans les travaux de rénovation, les copropriétés et les espaces commerciaux — de la spécification technique à l\'installation finale.',
            icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>',
          },
        ].map(item => (
          <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
            <div class="w-12 h-12 bg-[#8B1A1A] rounded-xl flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <Fragment set:html={item.icon} />
              </svg>
            </div>
            <h3 class="font-bold text-[#1A1A1A] mb-2">{item.area}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Marques et certifications -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-10">
        <h2 class="text-2xl font-black text-[#1A1A1A] mb-4">Marques et partenaires</h2>
        <p class="text-gray-600 leading-relaxed">
          Nous travaillons avec les marques leaders du marché, garantissant qualité et disponibilité des pièces à long terme.
        </p>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-6">
        {[
          { nome: 'Somfy', desc: 'Leader mondial des moteurs pour stores et volets. Protocole io-homecontrol et RTS.' },
          { nome: 'Nice', desc: 'Fabricant italien de solutions d\'automatisation. Moteurs silencieux et fiables.' },
          { nome: 'Rollease Acmeda', desc: 'Systèmes à enrouleur de haute précision pour installations résidentielles et commerciales.' },
          { nome: 'Bubendorff', desc: 'Stores extérieurs à haute performance énergétique, avec certification énergétique européenne.' },
        ].map(marca => (
          <div class="bg-[#F5F5F5] rounded-2xl p-5 text-center">
            <div class="font-black text-[#1A1A1A] text-lg mb-2">{marca.nome}</div>
            <p class="text-gray-500 text-xs leading-relaxed">{marca.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Zone d'intervention -->
  <section class="py-16 bg-[#F5F5F5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-[#8B1A1A] text-sm font-semibold uppercase tracking-widest mb-3 block">Où nous intervenons</span>
          <h2 class="text-2xl lg:text-3xl font-black text-[#1A1A1A] mb-6">Tout le Grand Lisbonne et au-delà</h2>
          <p class="text-gray-600 leading-relaxed mb-4">
            Notre zone d'intervention couvre tout le Grand Lisbonne — du centre historique de la capitale aux communes limitrophes. Nous nous déplaçons partout dans cette zone avec déplacement gratuit dans la majeure partie du Grand Lisbonne.
          </p>
          <p class="text-gray-600 leading-relaxed mb-6">
            Pour les projets de plus grande envergure (copropriétés, entreprises, travaux de rénovation), nous étudions les déplacements hors du Grand Lisbonne au cas par cas. Contactez-nous pour vérifier la couverture dans votre zone.
          </p>
          <a href="/fr/zones-couvertes/" class="inline-flex items-center gap-2 text-[#8B1A1A] font-semibold hover:underline">
            Voir toutes les zones que nous couvrons →
          </a>
        </div>
        <div class="flex flex-wrap gap-2">
          {['Lisbonne', 'Sintra', 'Cascais', 'Oeiras', 'Almada', 'Setúbal', 'Amadora', 'Loures', 'Odivelas', 'Mafra', 'Sesimbra', 'Palmela', 'Barreiro', 'Seixal'].map(zona => (
            <span class="bg-white border border-gray-200 text-gray-700 text-sm font-medium px-4 py-2 rounded-full shadow-sm">
              {zona}
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-[#1A1A1A] text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl lg:text-3xl font-black mb-4">
        Prêt à travailler avec nous ?
      </h2>
      <p class="text-gray-400 text-lg mb-8 max-w-2xl mx-auto">
        Demandez votre devis gratuit. Nous répondons en moins de 24 heures.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/fr/devis/" class="inline-flex items-center justify-center gap-2 bg-[#8B1A1A] text-white font-bold px-8 py-4 rounded-lg hover:bg-[#7a1717] transition-colors">
          Demander un devis gratuit
        </a>
        <a href="/fr/contact/" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white font-bold px-8 py-4 rounded-lg hover:bg-white/10 transition-colors">
          Parler à notre équipe
        </a>
      </div>
    </div>
  </section>

</Layout>
