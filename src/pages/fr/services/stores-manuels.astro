---
import Layout from '../../../layouts/Layout.astro';
import ContactForm from '../../../components/ContactForm.astro';
import ServiceExtras from '../../../components/ServiceExtras.astro';
import RelatedServices from '../../../components/RelatedServices.astro';
import { useTranslations } from '../../../i18n/utils';

const lang = 'fr' as const;
const t = useTranslations(lang);
---

<Layout
  title="Stores Manuels - Installation et Réparation à Lisbonne | Prime Estores"
  description="Installation de stores manuels de qualité à Lisbonne et Grand Lisbonne. Devis gratuit."
  schemaType="Service"
  serviceName="Installation de Stores Manuels à Lisbonne"
  serviceDescription="Installation de stores manuels de qualité à Lisbonne et Grand Lisbonne."
  lang={lang}
>
  <section class="bg-gradient-to-br from-[#1A1A1A] to-[#8B1A1A] text-white py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 text-sm text-white/80">
          <li><a href="/fr/" class="hover:text-white transition-colors">Accueil</a></li>
          <li aria-hidden="true"><span>/</span></li>
          <li><span class="text-white">Stores Manuels</span></li>
        </ol>
      </nav>
      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black leading-tight mb-4">{t('service.manual.h1')}</h1>
        <p class="text-xl text-white/80 leading-relaxed mb-8">Solutions pratiques et économiques pour toutes les pièces. Nous installons des stores manuels de qualité dans tout le Grand Lisbonne.</p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/fr/devis" class="inline-flex items-center justify-center gap-2 bg-white text-[#8B1A1A] font-bold px-6 py-3.5 rounded-lg hover:bg-gray-100 transition-colors">{t('hero.cta.quote')}</a>
          <a href="tel:+351923348323" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white font-bold px-6 py-3.5 rounded-lg hover:bg-white/10 transition-colors">+351 923 348 323</a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-12">
        <div class="lg:col-span-2">
          <h2 class="text-2xl lg:text-3xl font-black text-[#1A1A1A] mb-4">Stores manuels: qualité et praticité</h2>
          <p class="text-gray-600 leading-relaxed mb-6">Les stores manuels restent la solution la plus populaire pour le contrôle de la lumière et de la confidentialité. Économiques, faciles à utiliser et nécessitant peu d'entretien.</p>
          <a href="/fr/zones-couvertes" class="text-[#8B1A1A] font-semibold hover:underline text-sm">Voir toutes les zones couvertes →</a>
        </div>
        <div class="space-y-6">
          <ContactForm showTitle={true} lang={lang} />
        </div>
      </div>
    </div>
  </section>
  <ServiceExtras service="manual" lang={lang} />
  <RelatedServices current="manual" lang={lang} />
</Layout>
