---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import FAQ from '../components/FAQ.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import ContactForm from '../components/ContactForm.astro';

const faqs = [
  {
    question: 'Quanto custa instalar um estore elétrico?',
    answer: 'O custo de instalação de um estore elétrico varia consoante o tamanho, tipo de motor e complexidade da instalação. Em geral, os preços começam a partir de 150€ por unidade, incluindo mão de obra e materiais. Oferecemos sempre orçamento gratuito e sem compromisso antes de iniciar qualquer trabalho.',
  },
  {
    question: 'Quanto tempo demora uma instalação?',
    answer: 'Uma instalação padrão de estore elétrico ou manual demora entre 1 a 2 horas por unidade. Para instalações de múltiplos estores ou casos mais complexos, o prazo é calculado no momento do orçamento. Tentamos sempre minimizar o tempo de intervenção para causar o menor transtorno possível.',
  },
  {
    question: 'Fazem reparações urgentes?',
    answer: 'Sim, realizamos reparações urgentes em toda a Grande Lisboa. Dependendo da disponibilidade da nossa equipa, podemos intervir no mesmo dia ou no dia seguinte ao pedido. Para situações urgentes, recomendamos que contacte diretamente pelo telefone +351 923 348 323.',
  },
  {
    question: 'Qual a área de cobertura?',
    answer: 'Cobrimos toda a Grande Lisboa, incluindo os concelhos de Lisboa, Sintra, Cascais, Oeiras, Almada, Setúbal, Amadora, Loures, Odivelas, Vila Franca de Xira, Mafra, Sesimbra e Palmela. Para outras zonas, contacte-nos para verificar disponibilidade.',
  },
];
---

<Layout
  title="Instalação e Reparação de Estores em Lisboa | Prime Estores"
  description="Especialistas em estores elétricos e manuais em Lisboa e Grande Lisboa. Instalação profissional, reparação urgente e orçamento gratuito. Ligue +351 923 348 323."
  keywords="estores elétricos Lisboa, estores manuais Lisboa, reparação estores Lisboa, instalação estores Grande Lisboa, estores motorizados"
  faqs={faqs}
>

  <!-- Hero -->
  <Hero showStats={true} />

  <!-- Services -->
  <Services />

  <!-- Why Choose Us -->
  <WhyChooseUs />

  <GoogleReviews />

  <!-- FAQ -->
  <FAQ faqs={faqs} />

  <!-- Areas served banner -->
  <section class="py-12 bg-[#1A1A1A] text-white" aria-labelledby="areas-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 id="areas-heading" class="text-xl font-bold mb-3">Servimos toda a Grande Lisboa</h2>
      <p class="text-gray-400 text-sm mb-4">
        Lisboa &bull; Sintra &bull; Cascais &bull; Oeiras &bull; Almada &bull; Setúbal &bull; Amadora &bull; Loures &bull; Odivelas &bull; Mafra &bull; Sesimbra &bull; Palmela
      </p>
      <a href="/zonas-que-servimos" class="text-[#C0392B] hover:text-red-400 text-sm font-medium underline">
        Ver todas as zonas de serviço →
      </a>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="py-16 lg:py-20 bg-gradient-to-r from-[#8B1A1A] to-[#C0392B]" aria-labelledby="cta-heading">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 id="cta-heading" class="text-3xl lg:text-4xl font-black text-white mb-4">
        Pronto para transformar os seus estores?
      </h2>
      <p class="text-red-100 text-lg mb-8 max-w-2xl mx-auto">
        Contacte-nos hoje para um orçamento gratuito e sem compromisso. A nossa equipa está disponível de segunda a sábado das 8h às 20h.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/orcamento"
          class="inline-flex items-center justify-center gap-2 bg-white text-[#8B1A1A] font-bold px-8 py-4 rounded-lg hover:bg-gray-100 transition-colors text-base shadow-lg"
        >
          Pedir Orçamento Grátis
        </a>
        <a
          href="tel:+351923348323"
          class="inline-flex items-center justify-center gap-2 bg-transparent border-2 border-white text-white font-bold px-8 py-4 rounded-lg hover:bg-white/10 transition-colors text-base"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
          </svg>
          +351 923 348 323
        </a>
      </div>
    </div>
  </section>

  <!-- Contact Form section -->
  <section class="py-16 lg:py-24 bg-[#F5F5F5]" aria-labelledby="contact-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-start">

        <!-- Left: info -->
        <div>
          <span class="inline-block text-[#8B1A1A] text-sm font-semibold uppercase tracking-widest mb-2">Contacto</span>
          <h2 id="contact-heading" class="text-3xl lg:text-4xl font-black text-[#1A1A1A] mb-5">
            Fale connosco hoje
          </h2>
          <p class="text-gray-500 text-lg leading-relaxed mb-8">
            Estamos prontos para ajudá-lo com qualquer questão sobre os nossos serviços de estores elétricos e manuais em Lisboa.
          </p>

          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <div class="w-10 h-10 bg-[#8B1A1A] rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
                </svg>
              </div>
              <div>
                <div class="font-semibold text-[#1A1A1A]">Telefone</div>
                <a href="tel:+351923348323" class="text-gray-500 hover:text-[#8B1A1A] transition-colors">+351 923 348 323</a>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <div class="w-10 h-10 bg-[#8B1A1A] rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <div class="font-semibold text-[#1A1A1A]">Email</div>
                <a href="mailto:info@primeestores.pt" class="text-gray-500 hover:text-[#8B1A1A] transition-colors">info@primeestores.pt</a>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <div class="w-10 h-10 bg-[#8B1A1A] rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <div class="font-semibold text-[#1A1A1A]">Horário</div>
                <div class="text-gray-500">Segunda a Sábado: 08h00 – 20h00</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Form -->
        <ContactForm showTitle={false} />

      </div>
    </div>
  </section>

</Layout>
