---
import Layout from '../../../layouts/Layout.astro';
import ContactForm from '../../../components/ContactForm.astro';
import ServiceExtras from '../../../components/ServiceExtras.astro';
import RelatedServices from '../../../components/RelatedServices.astro';

const lang = 'it' as const;
---

<Layout
  title="Impianto Elettrico a Lisbona | Prime Estores"
  description="Installazione di prese, interruttori, lampadari e illuminazione LED a Lisbona e Grande Lisbona. Servizio rapido con tecnici certificati. Preventivo gratuito."
  keywords="impianto elettrico Lisbona, prese Lisbona, interruttori Lisbona, lampadari Lisbona, illuminazione LED Lisbona, elettricista Lisbona"
  schemaType="Service"
  serviceName="Impianto Elettrico a Lisbona"
  serviceDescription="Installazione di prese, interruttori, lampadari e illuminazione LED a Lisbona e Grande Lisbona. Tecnici certificati con garanzia di 1 anno."
  lang={lang}
>

  <!-- Page Hero -->
  <section class="bg-gradient-to-br from-[#1A1A1A] to-[#8B1A1A] text-white py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 text-sm text-white/60">
          <li><a href="/it/" class="hover:text-white transition-colors">Home</a></li>
          <li aria-hidden="true"><span>/</span></li>
          <li><span class="text-white">Impianto Elettrico</span></li>
        </ol>
      </nav>
      <div class="max-w-3xl">
        <span class="inline-block bg-white/10 border border-white/20 text-white text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full mb-4">Servizio</span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black leading-tight mb-4">
          Impianto Elettrico a Lisbona
        </h1>
        <p class="text-xl text-white/80 leading-relaxed mb-8">
          Prese, interruttori, lampadari e illuminazione LED. Servizio rapido con tecnici certificati in tutta la Grande Lisbona.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/it/preventivo" class="inline-flex items-center justify-center gap-2 bg-white text-[#8B1A1A] font-bold px-6 py-3.5 rounded-lg hover:bg-gray-100 transition-colors">
            Richiedi Preventivo Gratuito
          </a>
          <a href="tel:+351923348323" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white font-bold px-6 py-3.5 rounded-lg hover:bg-white/10 transition-colors">
            +351 923 348 323
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Main content -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-12">

        <!-- Content -->
        <div class="lg:col-span-2">
          <h2 class="text-2xl lg:text-3xl font-black text-[#1A1A1A] mb-4">Cosa facciamo</h2>
          <p class="text-gray-600 leading-relaxed mb-6">
            Presso Prime Estores eseguiamo lavori di elettricità per abitazioni e aziende in tutta la Grande Lisbona. Dall'installazione di prese e interruttori al montaggio di lampadari e sistemi di illuminazione LED — facciamo tutto con precisione, rapidità e garanzia inclusa.
          </p>
          <p class="text-gray-600 leading-relaxed mb-6">
            Tutti i lavori sono eseguiti da tecnici certificati, con materiali di qualità e nel rispetto delle norme di sicurezza elettrica vigenti. Senza sporcizia, senza danni alle pareti, senza sorprese alla fine.
          </p>

          <h2 class="text-2xl font-black text-[#1A1A1A] mb-4 mt-8">Cosa includiamo</h2>
          <div class="grid sm:grid-cols-2 gap-4 mb-8">
            {[
              { title: 'Installazione di prese', desc: 'Prese singole, doppie, triple e con caricatore USB integrato' },
              { title: 'Installazione di interruttori', desc: 'Interruttori semplici, deviatori e dimmer per la regolazione della luce' },
              { title: 'Montaggio di lampadari', desc: 'Plafoniere, applique da parete e lampadari a sospensione decorativi' },
              { title: 'Illuminazione LED', desc: 'Faretti da incasso, strisce LED, pannelli LED e applique a basso consumo' },
              { title: 'Lavoro rapido e pulito', desc: 'Senza danni a pareti o finiture — lasciamo tutto come lo abbiamo trovato' },
              { title: 'Garanzia di 1 anno', desc: 'Tutti i lavori elettrici eseguiti hanno garanzia di 1 anno inclusa' },
            ].map(item => (
              <div class="flex gap-3 p-4 bg-[#F5F5F5] rounded-xl">
                <svg class="w-5 h-5 text-[#8B1A1A] flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                <div>
                  <div class="font-semibold text-[#1A1A1A] text-sm">{item.title}</div>
                  <div class="text-gray-500 text-xs mt-0.5">{item.desc}</div>
                </div>
              </div>
            ))}
          </div>

          <h2 class="text-2xl font-black text-[#1A1A1A] mb-4 mt-8">Come funziona il nostro processo</h2>
          <ol class="space-y-4 mb-8">
            {[
              { step: '01', title: 'Contatto e preventivo gratuito', desc: 'Contattateci per telefono o tramite modulo. Valutiamo il lavoro e presentiamo un preventivo senza impegno.' },
              { step: '02', title: 'Sopralluogo', desc: 'Per lavori più complessi, ci rechiamo sul posto per valutare l\'impianto esistente e pianificare il lavoro.' },
              { step: '03', title: 'Pianificazione', desc: 'Fissiamo la data e l\'orario più comodi per voi. Garantiamo puntualità.' },
              { step: '04', title: 'Esecuzione professionale', desc: 'I nostri tecnici eseguono il lavoro in modo rapido, pulito e sicuro, nel rispetto di tutte le norme elettriche.' },
              { step: '05', title: 'Consegna e garanzia', desc: 'Testiamo tutto prima di andarcene e consegniamo il servizio con garanzia di 1 anno inclusa.' },
            ].map(item => (
              <li class="flex gap-4">
                <div class="flex-shrink-0 w-10 h-10 bg-[#8B1A1A] text-white rounded-full flex items-center justify-center font-black text-sm">
                  {item.step}
                </div>
                <div>
                  <div class="font-semibold text-[#1A1A1A]">{item.title}</div>
                  <div class="text-gray-500 text-sm mt-0.5">{item.desc}</div>
                </div>
              </li>
            ))}
          </ol>

          <h2 class="text-2xl font-black text-[#1A1A1A] mb-4 mt-8">Zone di copertura</h2>
          <p class="text-gray-600 leading-relaxed mb-4">
            Forniamo servizi elettrici in tutta la <strong>Grande Lisbona</strong>, tra cui: Lisbona (tutti i quartieri), Sintra, Cascais, Oeiras, Almada, Setúbal, Amadora, Loures, Odivelas, Vila Franca de Xira, Mafra, Sesimbra e Palmela.
          </p>
          <a href="/it/zone-servite" class="text-[#8B1A1A] font-semibold hover:underline text-sm">
            Vedi tutte le zone servite →
          </a>
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
          <ContactForm showTitle={true} lang={lang} />
          <div class="bg-[#F5F5F5] rounded-2xl p-6">
            <h3 class="font-bold text-[#1A1A1A] mb-4">Informazioni utili</h3>
            <div class="space-y-3 text-sm">
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-[#8B1A1A]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <span class="text-gray-600">Risposta entro 24h</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-[#8B1A1A]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
                <span class="text-gray-600">Garanzia di 1 anno</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-[#8B1A1A]" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                <span class="text-gray-600">Preventivo 100% gratuito</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-[#8B1A1A]" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                <span class="text-gray-600">Tecnici certificati</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <ServiceExtras service="electrical" lang={lang} />
  <RelatedServices current="electrical" lang={lang} />
</Layout>
