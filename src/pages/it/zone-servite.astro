---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/utils';

const lang = 'it' as const;
const t = useTranslations(lang);

const zones = [
  { name: 'Lisbona', slug: 'lisbona', desc: 'Serviamo tutti i quartieri e le parrocchie di Lisbona, da Alfama e Mouraria a Parque das Nações, Belém, Alvalade e tutti gli altri. La capitale è la nostra principale area operativa.' },
  { name: 'Sintra', slug: 'sintra', desc: 'Copriamo l\'intero comune di Sintra, incluse Sintra Vila, Rio de Mouro, Agualva-Cacém, Algueirão-Mem Martins, Queluz, Massamá e Belas.' },
  { name: 'Cascais', slug: 'cascais', desc: 'Serviamo l\'intero comune di Cascais, incluse Cascais centro, Estoril, Parede, Carcavelos, São Domingos de Rana e Alcabideche.' },
  { name: 'Oeiras', slug: 'oeiras', desc: 'Serviamo l\'intero comune di Oeiras, incluse Oeiras centro, Porto Salvo, Barcarena, Carnaxide, Linda-a-Velha, Algés e Cruz Quebrada.' },
  { name: 'Almada', slug: 'almada', desc: 'Copriamo Almada e tutte le sue località, incluse Costa da Caparica, Trafaria, Cacilhas, Almada Velha, Cova da Piedade e Laranjeiro.' },
  { name: 'Setúbal', slug: 'setubal', desc: 'Serviamo il comune di Setúbal e dintorni, inclusa la città di Setúbal e zone come Azeitão, São Bernardo e Sado.' },
  { name: 'Amadora', slug: 'amadora', desc: 'Copriamo l\'intero comune di Amadora, incluse Alfornelos, Brandoa, Damaia, Falagueira, Mina de Água, Reboleira e Venteira.' },
  { name: 'Loures', slug: 'loures', desc: 'Serviamo il comune di Loures, incluse Loures centro, Sacavém, Santa Iria de Azóia, Moscavide, Prior Velho e dintorni.' },
  { name: 'Odivelas', slug: 'odivelas', desc: 'Copriamo l\'intero comune di Odivelas, incluse Odivelas centro, Pontinha, Famões, Póvoa de Santo Adrião e Ramada.' },
  { name: 'Vila Franca de Xira', slug: 'vfx', desc: 'Serviamo Vila Franca de Xira e il suo intero comune, incluse Alverca do Ribatejo, Vialonga, Sobralinho e Forte da Casa.' },
  { name: 'Mafra', slug: 'mafra', desc: 'Copriamo il comune di Mafra, incluse Mafra centro, Ericeira, Malveira, Cheleiros e altre località.' },
  { name: 'Sesimbra', slug: 'sesimbra', desc: 'Serviamo Sesimbra e il suo comune, incluse Sesimbra centro, Santana, Cotovia e Quinta do Conde.' },
];
---

<Layout
  title="Zone Servite | Prime Estores - Grande Lisbona"
  description="Installazione e riparazione tende in tutta la Grande Lisbona: Lisbona, Sintra, Cascais, Oeiras, Almada, Setúbal, Amadora, Loures, Odivelas e altro. Preventivo gratuito."
  lang={lang}
>
  <section class="bg-gradient-to-br from-[#1A1A1A] to-[#8B1A1A] text-white py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 text-sm text-white/80">
          <li><a href="/it/" class="hover:text-white transition-colors">Home</a></li>
          <li aria-hidden="true"><span>/</span></li>
          <li><span class="text-white">Zone Servite</span></li>
        </ol>
      </nav>
      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black leading-tight mb-4">{t('zones.title')}</h1>
        <p class="text-xl text-white/80 leading-relaxed">{t('zones.subtitle')}</p>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-[#F5F5F5]" aria-labelledby="zones-heading-it">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 id="zones-heading-it" class="sr-only">Comuni che serviamo</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {zones.map(zone => (
          <article id={zone.slug} class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 hover:shadow-md transition-shadow scroll-mt-24">
            <div class="flex items-start gap-3 mb-3">
              <div class="w-8 h-8 bg-[#8B1A1A] rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <h3 class="text-xl font-black text-[#1A1A1A]">{zone.name}</h3>
            </div>
            <p class="text-gray-600 text-sm leading-relaxed mb-4">{zone.desc}</p>
            <a href="/it/preventivo" class="inline-flex items-center gap-1 text-[#8B1A1A] font-semibold text-sm hover:gap-2 transition-all hover:underline">
              Richiedi preventivo a {zone.name}
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-[#8B1A1A] text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-black mb-4">Non vedi la tua zona?</h2>
      <p class="text-red-100 text-lg mb-8">Contattaci per verificare la disponibilità. Cerchiamo di raggiungere qualsiasi punto dell'area metropolitana di Lisbona.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/it/preventivo" class="inline-flex items-center justify-center gap-2 bg-white text-[#8B1A1A] font-bold px-8 py-4 rounded-lg hover:bg-gray-100 transition-colors">Preventivo Gratuito</a>
        <a href="tel:+351923348323" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white font-bold px-8 py-4 rounded-lg hover:bg-white/10 transition-colors">+351 923 348 323</a>
      </div>
    </div>
  </section>
</Layout>
