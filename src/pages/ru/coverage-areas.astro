---
import Layout from '../../layouts/Layout.astro';
import HelpfulContent from '../../components/HelpfulContent.astro';
import { useTranslations } from '../../i18n/utils';

const lang = 'ru' as const;
const t = useTranslations(lang);

const zones = [
  { name: 'Лиссабон', slug: 'lisboa', desc: 'Мы обслуживаем все районы и приходы Лиссабона, от Алфамы и Мурарии до Парке-даш-Нашойнш, Белена, Алвалади и всех остальных. Столица — наша основная зона деятельности.' },
  { name: 'Синтра', slug: 'sintra', desc: 'Мы охватываем весь муниципалитет Синтра, включая Синтра-Вила, Рио-де-Мору, Агуалва-Касем, Алгейран-Мем-Мартинш, Келуш, Массама и Белаш.' },
  { name: 'Кашкайш', slug: 'cascais', desc: 'Мы обслуживаем весь муниципалитет Кашкайш, включая центр Кашкайша, Эшторил, Пареде, Каркавелуш, Сан-Домингуш-де-Рана и Алкабидеше.' },
  { name: 'Оэйраш', slug: 'oeiras', desc: 'Мы обслуживаем весь муниципалитет Оэйраш, включая центр Оэйраша, Порту-Салву, Баркарену, Карнашиде, Линда-а-Велья, Алжеш и Круж-Кебрада.' },
  { name: 'Алмада', slug: 'almada', desc: 'Мы охватываем Алмаду и все её населённые пункты, включая Кошта-да-Капарика, Трафарию, Касильяш, Алмада-Велья, Кова-да-Пиедаде и Ларанжейру.' },
  { name: 'Сетубал', slug: 'setubal', desc: 'Мы обслуживаем муниципалитет Сетубал и окрестности, включая город Сетубал и такие районы, как Азейтан, Сан-Бернарду и Саду.' },
  { name: 'Амадора', slug: 'amadora', desc: 'Мы охватываем весь муниципалитет Амадора, включая Алфорнелуш, Брандоа, Дамайя, Фалагейра, Мина-де-Агуа, Реболейра и Вентейра.' },
  { name: 'Лориш', slug: 'loures', desc: 'Мы обслуживаем муниципалитет Лориш, включая центр Лориша, Сакавем, Санта-Ирия-де-Азойя, Мошкавиде, Приор-Велью и окрестности.' },
  { name: 'Одивелаш', slug: 'odivelas', desc: 'Мы охватываем весь муниципалитет Одивелаш, включая центр Одивелаша, Понтинью, Фамойнш, Повоа-де-Санту-Адриан и Рамаду.' },
  { name: 'Вила-Франка-де-Шира', slug: 'vila-franca-de-xira', desc: 'Мы обслуживаем Вила-Франка-де-Шира и весь её муниципалитет, включая Алверка-ду-Рибатежу, Виалонгу, Собралинью и Форте-да-Каса.' },
  { name: 'Мафра', slug: 'mafra', desc: 'Мы охватываем муниципалитет Мафра, включая центр Мафры, Эрисейру, Малвейру, Шелейруш и другие населённые пункты.' },
  { name: 'Сезимбра', slug: 'sesimbra', desc: 'Мы обслуживаем Сезимбру и её муниципалитет, включая центр Сезимбры, Сантану, Котовию и Кинта-ду-Конде.' },
  { name: 'Палмела', slug: 'palmela', desc: 'Мы обслуживаем муниципалитет Палмела, включая центр Палмелы, Пиньял-Нову и Кинта-ду-Анжу, с установкой и ремонтом электрических и ручных рольставней.' },
];
---

<Layout
  title="Зоны обслуживания | Prime Estores - Большой Лиссабон"
  description="Установка и ремонт рольставней по всему Большому Лиссабону: Лиссабон, Синтра, Кашкайш, Оэйраш, Алмада, Сетубал, Амадора, Лориш, Одивелаш и другие. Бесплатная смета."
  lang={lang}
>
  <section class="bg-gradient-to-br from-[#1A1A1A] to-[#8B1A1A] text-white py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 text-sm text-white/80">
          <li><a href="/ru/" class="hover:text-white transition-colors">Главная</a></li>
          <li aria-hidden="true"><span>/</span></li>
          <li><span class="text-white">Зоны обслуживания</span></li>
        </ol>
      </nav>
      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black leading-tight mb-4">{t('zones.title')}</h1>
        <p class="text-xl text-white/80 leading-relaxed">{t('zones.subtitle')}</p>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-[#F5F5F5]" aria-labelledby="zones-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 id="zones-heading" class="sr-only">Муниципалитеты, которые мы обслуживаем</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {zones.map(zone => (
          <article id={zone.slug} class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 hover:shadow-md transition-shadow scroll-mt-24">
            <div class="flex items-start gap-3 mb-3">
              <div class="w-8 h-8 bg-[#8B1A1A] rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <h3 class="text-xl font-black text-[#1A1A1A]">{zone.name}</h3>
            </div>
            <p class="text-gray-600 text-sm leading-relaxed mb-4">{zone.desc}</p>
            <a href={`/ru/coverage-areas/${zone.slug}`} class="inline-flex items-center gap-1 text-[#8B1A1A] font-semibold text-sm hover:gap-2 transition-all hover:underline">
              Услуги по рольставням в {zone.name}
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-[#8B1A1A] text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-black mb-4">Не нашли свой район?</h2>
      <p class="text-red-100 text-lg mb-8">Свяжитесь с нами, чтобы проверить доступность. Мы стараемся добраться до любой точки Лиссабонской агломерации.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/ru/quote/" class="inline-flex items-center justify-center gap-2 bg-white text-[#8B1A1A] font-bold px-8 py-4 rounded-lg hover:bg-gray-100 transition-colors">Получить бесплатную смету</a>
        <a href="tel:+351923348323" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white font-bold px-8 py-4 rounded-lg hover:bg-white/10 transition-colors">+351 923 348 323</a>
      </div>
    </div>
  </section>
  <HelpfulContent lang={lang} page="coverage" />
</Layout>
