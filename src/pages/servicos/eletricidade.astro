---
import Layout from '../../layouts/Layout.astro';
import ContactForm from '../../components/ContactForm.astro';
import ServiceExtras from '../../components/ServiceExtras.astro';
import RelatedServices from '../../components/RelatedServices.astro';
---

<Layout
  title="Instalação Elétrica em Lisboa | Prime Estores"
  description="Instalação de tomadas, interruptores, candeeiros e iluminação LED em Lisboa e Grande Lisboa. Serviço rápido com técnicos certificados. Orçamento grátis."
  keywords="instalação elétrica Lisboa, tomadas Lisboa, interruptores Lisboa, candeeiros Lisboa, eletricista Lisboa, iluminação LED Lisboa"
  schemaType="Service"
  serviceName="Instalação Elétrica em Lisboa"
  serviceDescription="Instalação de tomadas, interruptores, candeeiros e iluminação LED em Lisboa e Grande Lisboa. Técnicos certificados com garantia de 1 ano."
>

  <!-- Page Hero -->
  <section class="bg-gradient-to-br from-[#1A1A1A] to-[#8B1A1A] text-white py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 text-sm text-white/80">
          <li><a href="/" class="hover:text-white transition-colors">Início</a></li>
          <li aria-hidden="true"><span>/</span></li>
          <li><span class="text-white">Eletricidade</span></li>
        </ol>
      </nav>
      <div class="max-w-3xl">
        <span class="inline-block bg-white/10 border border-white/20 text-white text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full mb-4">Serviço</span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black leading-tight mb-4">
          Instalação Elétrica em Lisboa
        </h1>
        <p class="text-xl text-white/80 leading-relaxed mb-8">
          Tomadas, interruptores, candeeiros e iluminação LED. Serviço rápido com técnicos certificados em toda a Grande Lisboa.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/orcamento" class="inline-flex items-center justify-center gap-2 bg-white text-[#8B1A1A] font-bold px-6 py-3.5 rounded-lg hover:bg-gray-100 transition-colors">
            Pedir Orçamento Grátis
          </a>
          <a href="tel:+351923348323" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white font-bold px-6 py-3.5 rounded-lg hover:bg-white/10 transition-colors">
            +351 923 348 323
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Main content -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-12">

        <!-- Content -->
        <div class="lg:col-span-2">
          <h2 class="text-2xl lg:text-3xl font-black text-[#1A1A1A] mb-4">O que fazemos</h2>
          <p class="text-gray-600 leading-relaxed mb-6">
            Na Prime Estores, realizamos trabalhos de eletricidade para habitações e empresas em toda a Grande Lisboa. Da instalação de tomadas e interruptores à montagem de candeeiros e sistemas de iluminação LED — fazemos tudo com rigor, rapidez e garantia incluída.
          </p>
          <p class="text-gray-600 leading-relaxed mb-6">
            Todos os trabalhos são executados por técnicos certificados, com materiais de qualidade e cumprindo as normas de segurança elétrica em vigor. Sem sujidade, sem danos nas paredes, sem surpresas no final.
          </p>

          <h2 class="text-2xl font-black text-[#1A1A1A] mb-4 mt-8">O que incluímos</h2>
          <div class="grid sm:grid-cols-2 gap-4 mb-8">
            {[
              { title: 'Instalação de tomadas', desc: 'Tomadas simples, duplas, triplas e com carregador USB integrado' },
              { title: 'Instalação de interruptores', desc: 'Interruptores simples, dois-way e reguladores de intensidade (dimmer)' },
              { title: 'Montagem de candeeiros', desc: 'Candeeiros de teto, apliques de parede e pendentes decorativos' },
              { title: 'Iluminação LED', desc: 'Spots embutidos, fitas LED, painéis LED e apliques de baixo consumo' },
              { title: 'Trabalho rápido e limpo', desc: 'Sem danos em paredes ou acabamentos — deixamos tudo como encontrámos' },
              { title: 'Garantia de 1 ano', desc: 'Todos os trabalhos elétricos realizados têm garantia de 1 ano incluída' },
            ].map(item => (
              <div class="flex gap-3 p-4 bg-[#F5F5F5] rounded-xl">
                <svg class="w-5 h-5 text-[#8B1A1A] flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                <div>
                  <div class="font-semibold text-[#1A1A1A] text-sm">{item.title}</div>
                  <div class="text-gray-500 text-xs mt-0.5">{item.desc}</div>
                </div>
              </div>
            ))}
          </div>

          <h2 class="text-2xl font-black text-[#1A1A1A] mb-4 mt-8">Como funciona o nosso processo</h2>
          <ol class="space-y-4 mb-8">
            {[
              { step: '01', title: 'Contacto e orçamento gratuito', desc: 'Entre em contacto por telefone ou formulário. Avaliamos o trabalho e apresentamos orçamento sem compromisso.' },
              { step: '02', title: 'Avaliação no local', desc: 'Em casos mais complexos, deslocamo-nos para avaliar a instalação existente e planear o trabalho.' },
              { step: '03', title: 'Agendamento', desc: 'Marcamos a data e hora mais conveniente para si. Garantimos pontualidade.' },
              { step: '04', title: 'Execução profissional', desc: 'Os nossos técnicos realizam o trabalho de forma rápida, limpa e segura, respeitando todas as normas elétricas.' },
              { step: '05', title: 'Entrega e garantia', desc: 'Testamos tudo antes de sair e entregamos o serviço com garantia de 1 ano incluída.' },
            ].map(item => (
              <li class="flex gap-4">
                <div class="flex-shrink-0 w-10 h-10 bg-[#8B1A1A] text-white rounded-full flex items-center justify-center font-black text-sm">
                  {item.step}
                </div>
                <div>
                  <div class="font-semibold text-[#1A1A1A]">{item.title}</div>
                  <div class="text-gray-500 text-sm mt-0.5">{item.desc}</div>
                </div>
              </li>
            ))}
          </ol>

          <h2 class="text-2xl font-black text-[#1A1A1A] mb-4 mt-8">Zonas de cobertura</h2>
          <p class="text-gray-600 leading-relaxed mb-4">
            Prestamos serviços de eletricidade em toda a <strong>Grande Lisboa</strong>, incluindo: Lisboa (todos os bairros), Sintra, Cascais, Oeiras, Almada, Setúbal, Amadora, Loures, Odivelas, Vila Franca de Xira, Mafra, Sesimbra e Palmela.
          </p>
          <a href="/zonas-que-servimos" class="text-[#8B1A1A] font-semibold hover:underline text-sm">
            Ver todas as zonas que servimos →
          </a>
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
          <ContactForm showTitle={true} />
          <div class="bg-[#F5F5F5] rounded-2xl p-6">
            <h3 class="font-bold text-[#1A1A1A] mb-4">Informações úteis</h3>
            <div class="space-y-3 text-sm">
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-[#8B1A1A]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <span class="text-gray-600">Resposta em menos de 24h</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-[#8B1A1A]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
                <span class="text-gray-600">Garantia de 1 ano</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-[#8B1A1A]" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                <span class="text-gray-600">Orçamento 100% gratuito</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-[#8B1A1A]" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                <span class="text-gray-600">Técnicos certificados</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <ServiceExtras service="electrical" />
  <RelatedServices current="electrical" />
</Layout>
