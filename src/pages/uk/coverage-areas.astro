---
import Layout from '../../layouts/Layout.astro';
import HelpfulContent from '../../components/HelpfulContent.astro';
import { useTranslations } from '../../i18n/utils';

const lang = 'uk' as const;
const t = useTranslations(lang);

const zones = [
  { name: 'Лісабон', slug: 'lisboa', desc: 'Ми обслуговуємо всі райони та парафії Лісабона, від Алфами та Мурарії до Парке-даш-Насойнш, Белена, Алвалади та всіх інших. Столиця — наша основна зона роботи.' },
  { name: 'Сінтра', slug: 'sintra', desc: 'Ми охоплюємо весь муніципалітет Сінтра, включно з Сінтра-Віла, Ріо-де-Моуро, Агуалва-Касен, Алгейран-Мем-Мартінш, Келуш, Массама та Белаш.' },
  { name: 'Кашкайш', slug: 'cascais', desc: 'Ми обслуговуємо весь муніципалітет Кашкайш, включно з центром Кашкайша, Ешторілом, Пареде, Каркавелушем, Сан-Домінгуш-де-Рана та Алкабідеше.' },
  { name: 'Оейраш', slug: 'oeiras', desc: 'Ми обслуговуємо весь муніципалітет Оейраш, включно з центром Оейраша, Порту-Салву, Баркарена, Карнашіде, Лінда-а-Велья, Алжеш та Круж-Кебрада.' },
  { name: 'Алмада', slug: 'almada', desc: 'Ми охоплюємо Алмаду та всі її населені пункти, включно з Кошта-да-Капаріка, Трафарією, Касільяш, Алмада-Велья, Кова-да-Піедаде та Ларанжейру.' },
  { name: 'Сетубал', slug: 'setubal', desc: 'Ми обслуговуємо муніципалітет Сетубал та околиці, включно з містом Сетубал та такими районами, як Азейтан, Сан-Бернарду та Саду.' },
  { name: 'Амадора', slug: 'amadora', desc: 'Ми охоплюємо весь муніципалітет Амадора, включно з Алфорнелуш, Брандоа, Дамая, Фалагейра, Міна-де-Агуа, Реболейра та Вентейра.' },
  { name: 'Лоуреш', slug: 'loures', desc: 'Ми обслуговуємо муніципалітет Лоуреш, включно з центром Лоуреша, Сакавен, Санта-Ірія-де-Азоя, Мошкавіде, Пріор-Велью та околицями.' },
  { name: 'Одівелаш', slug: 'odivelas', desc: 'Ми охоплюємо весь муніципалітет Одівелаш, включно з центром Одівелаша, Понтінья, Фамойнш, Повоа-де-Санту-Адріан та Рамада.' },
  { name: 'Віла-Франка-де-Шіра', slug: 'vila-franca-de-xira', desc: 'Ми обслуговуємо Віла-Франка-де-Шіра та весь її муніципалітет, включно з Алверка-ду-Рібатежу, Віалонга, Собралінью та Форте-да-Каса.' },
  { name: 'Мафра', slug: 'mafra', desc: 'Ми охоплюємо муніципалітет Мафра, включно з центром Мафри, Ерісейра, Малвейра, Шелейруш та іншими населеними пунктами.' },
  { name: 'Сезімбра', slug: 'sesimbra', desc: 'Ми обслуговуємо Сезімбру та її муніципалітет, включно з центром Сезімбри, Сантана, Котовія та Кінта-ду-Конде.' },
  { name: 'Палмела', slug: 'palmela', desc: 'Ми обслуговуємо муніципалітет Палмела, включно з центром Палмели, Пінял-Нову та Кінта-ду-Анжу, зі встановленням та ремонтом електричних і ручних ролетів.' },
];
---

<Layout
  title="Зони обслуговування | Prime Estores - Великий Лісабон"
  description="Встановлення та ремонт ролетів по всьому Великому Лісабону: Лісабон, Сінтра, Кашкайш, Оейраш, Алмада, Сетубал, Амадора, Лоуреш, Одівелаш та інші. Безкоштовний кошторис."
  lang={lang}
>
  <section class="bg-gradient-to-br from-[#1A1A1A] to-[#8B1A1A] text-white py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 text-sm text-white/80">
          <li><a href="/uk/" class="hover:text-white transition-colors">Головна</a></li>
          <li aria-hidden="true"><span>/</span></li>
          <li><span class="text-white">Зони обслуговування</span></li>
        </ol>
      </nav>
      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black leading-tight mb-4">{t('zones.title')}</h1>
        <p class="text-xl text-white/80 leading-relaxed">{t('zones.subtitle')}</p>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-[#F5F5F5]" aria-labelledby="zones-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 id="zones-heading" class="sr-only">Муніципалітети, які ми обслуговуємо</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {zones.map(zone => (
          <article id={zone.slug} class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 hover:shadow-md transition-shadow scroll-mt-24">
            <div class="flex items-start gap-3 mb-3">
              <div class="w-8 h-8 bg-[#8B1A1A] rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <h3 class="text-xl font-black text-[#1A1A1A]">{zone.name}</h3>
            </div>
            <p class="text-gray-600 text-sm leading-relaxed mb-4">{zone.desc}</p>
            <a href={`/uk/coverage-areas/${zone.slug}`} class="inline-flex items-center gap-1 text-[#8B1A1A] font-semibold text-sm hover:gap-2 transition-all hover:underline">
              Послуги з ролетів у {zone.name}
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 bg-[#8B1A1A] text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-black mb-4">Не бачите свого району?</h2>
      <p class="text-red-100 text-lg mb-8">Звʼяжіться з нами, щоб перевірити доступність. Ми намагаємося дістатися будь-якої точки Лісабонської агломерації.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/uk/quote" class="inline-flex items-center justify-center gap-2 bg-white text-[#8B1A1A] font-bold px-8 py-4 rounded-lg hover:bg-gray-100 transition-colors">Отримати безкоштовний кошторис</a>
        <a href="tel:+351923348323" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white font-bold px-8 py-4 rounded-lg hover:bg-white/10 transition-colors">+351 923 348 323</a>
      </div>
    </div>
  </section>
  <HelpfulContent lang={lang} page="coverage" />
</Layout>
