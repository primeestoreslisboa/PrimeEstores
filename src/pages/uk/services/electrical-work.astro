---
import Layout from '../../../layouts/Layout.astro';
import ContactForm from '../../../components/ContactForm.astro';
import RelatedServices from '../../../components/RelatedServices.astro';
import { useTranslations } from '../../../i18n/utils';

const lang = 'uk' as const;
const t = useTranslations(lang);
---

<Layout
  title="Електромонтажні роботи в Лісабоні | Prime Estores"
  description="Електромонтажні роботи для ролетів та розумного дому в Лісабоні та Великому Лісабоні: підключення моторів, вимикачів, автоматики. Сертифіковані фахівці. Безкоштовний кошторис."
  schemaType="Service"
  serviceName="Електромонтажні роботи в Лісабоні"
  serviceDescription="Електромонтажні роботи, повʼязані зі встановленням та автоматизацією ролетів, у Лісабоні та Великому Лісабоні."
  lang={lang}
>
  <section class="bg-gradient-to-br from-[#1A1A1A] to-[#8B1A1A] text-white py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex items-center gap-2 text-sm text-white/80">
          <li><a href="/uk/" class="hover:text-white transition-colors">Головна</a></li>
          <li aria-hidden="true"><span>/</span></li>
          <li><span class="text-white">Електромонтажні роботи</span></li>
        </ol>
      </nav>
      <div class="max-w-3xl">
        <span class="inline-block bg-white/10 border border-white/20 text-white text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full mb-4">Послуга</span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black leading-tight mb-4">Електромонтажні роботи в Лісабоні</h1>
        <p class="text-xl text-white/80 leading-relaxed mb-8">Надійна електрика для ваших ролетів і розумного дому. Виконуємо підключення моторів, вимикачів та автоматики з гарантією безпеки по всьому Великому Лісабону.</p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/uk/quote/" class="inline-flex items-center justify-center gap-2 bg-white text-[#8B1A1A] font-bold px-6 py-3.5 rounded-lg hover:bg-gray-100 transition-colors">Отримати безкоштовний кошторис</a>
          <a href="tel:+351923348323" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white font-bold px-6 py-3.5 rounded-lg hover:bg-white/10 transition-colors">+351 923 348 323</a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-12">
        <div class="lg:col-span-2">
          <h2 class="text-2xl lg:text-3xl font-black text-[#1A1A1A] mb-4">Електрика для ролетів і не тільки</h2>
          <p class="text-gray-600 leading-relaxed mb-6">Окрім встановлення ролетів, ми виконуємо повʼязані з ними електромонтажні роботи: прокладання ліній живлення для моторів, встановлення вимикачів і приймачів, підготовку електрики для автоматизації та розумного дому.</p>
          <p class="text-gray-600 leading-relaxed mb-6">Усі роботи виконують сертифіковані фахівці Prime Estores з дотриманням норм безпеки, акуратно й без зайвих руйнувань по всьому Великому Лісабону.</p>

          <h2 class="text-2xl font-black text-[#1A1A1A] mb-4 mt-8">Що ми виконуємо</h2>
          <div class="grid sm:grid-cols-2 gap-4 mb-8">
            {[
              { title: 'Живлення для моторів', desc: 'Прокладання та підключення ліній для електричних ролетів' },
              { title: 'Вимикачі та керування', desc: 'Встановлення настінних вимикачів, кнопок і приймачів' },
              { title: 'Підготовка до автоматизації', desc: 'Електрика під системи розумного дому та сценарії' },
              { title: 'Дрібний електромонтаж', desc: 'Розетки, точки освітлення та підключення на місці' },
              { title: 'Перевірка та безпека', desc: 'Перевірка зʼєднань і захист мереж' },
              { title: 'Акуратний монтаж', desc: 'Чиста робота без зайвих руйнувань' },
            ].map(item => (
              <div class="flex gap-3 p-4 bg-[#F5F5F5] rounded-xl">
                <svg class="w-5 h-5 text-[#8B1A1A] flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                <div>
                  <div class="font-semibold text-[#1A1A1A] text-sm">{item.title}</div>
                  <div class="text-gray-500 text-xs mt-0.5">{item.desc}</div>
                </div>
              </div>
            ))}
          </div>

          <h2 class="text-2xl font-black text-[#1A1A1A] mb-4 mt-8">Зони обслуговування</h2>
          <p class="text-gray-600 leading-relaxed mb-4">Ми виконуємо електромонтажні роботи по всьому <strong>Великому Лісабону</strong>, включно з: Лісабон (усі райони), Сінтра, Кашкайш, Оейраш, Алмада, Сетубал, Амадора, Лоуреш, Одівелаш та інші.</p>
          <a href="/uk/coverage-areas/" class="text-[#8B1A1A] font-semibold hover:underline text-sm">Переглянути всі зони обслуговування →</a>
        </div>
        <div class="space-y-6">
          <ContactForm showTitle={true} lang={lang} />
          <div class="bg-[#F5F5F5] rounded-2xl p-6">
            <h3 class="font-bold text-[#1A1A1A] mb-4">Корисна інформація</h3>
            <div class="space-y-3 text-sm">
              {['Відповідь протягом 24 годин', 'Сертифіковані фахівці', '100% безкоштовний кошторис', 'Дотримання норм безпеки'].map(item => (
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-[#8B1A1A]" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  <span class="text-gray-600">{item}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <RelatedServices current="electrical" lang="uk" />
</Layout>
