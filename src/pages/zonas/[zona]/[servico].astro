---
import Layout from '../../../layouts/Layout.astro';
import { zonas } from '../../../data/zonaData';
import type { ZonaData } from '../../../data/zonaData';
import { serviceData } from '../../../data/serviceFAQ';
import { servicosMatriz } from '../../../data/servicosMatriz';
import type { ServicoMatriz } from '../../../data/servicosMatriz';

// ---------------------------------------------------------------------------
// Service × Zona matrix — programmatic local landing pages.
// Targets long-tail local queries like "reparação de estores Cascais",
// "estores elétricos Sintra", etc. Each page reuses the zona's unique
// intro/detail/bairros + the service's pricing/FAQ so content is never thin.
// ---------------------------------------------------------------------------

export function getStaticPaths() {
  return zonas.flatMap(zona =>
    servicosMatriz.map(servico => ({
      params: { zona: zona.slug, servico: servico.slug },
      props: { zona, servico },
    }))
  );
}

interface Props {
  zona: ZonaData;
  servico: ServicoMatriz;
}

const { zona, servico } = Astro.props as Props;

const baseUrl = 'https://primeestores.pt';
const pageUrl = `${baseUrl}/zonas/${zona.slug}/${servico.slug}/`;
const sd = serviceData[servico.type].pt;

// Sibling services in the same zona (cross-linking)
const outros = servicosMatriz.filter(s => s.slug !== servico.slug);

const schemaService = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `${servico.nome} em ${zona.nome}`,
  description: servico.description(zona.nome),
  serviceType: servico.nome,
  areaServed: { '@type': 'City', name: zona.nome },
  provider: {
    '@type': 'LocalBusiness',
    name: 'Prime Estores',
    telephone: '+351923348323',
    url: baseUrl,
    image: `${baseUrl}/og-image.jpg`,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Lisboa',
      addressRegion: 'Lisboa',
      addressCountry: 'PT',
    },
    geo: { '@type': 'GeoCoordinates', latitude: zona.geo.lat, longitude: zona.geo.lng },
  },
  url: pageUrl,
};

const schemaBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: `${baseUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Zonas', item: `${baseUrl}/zonas-que-servimos/` },
    { '@type': 'ListItem', position: 3, name: zona.nome, item: `${baseUrl}/zonas/${zona.slug}/` },
    { '@type': 'ListItem', position: 4, name: servico.nome, item: pageUrl },
  ],
};

const schemaFAQ = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: sd.faq.map(item => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(schemaService)} />
<script type="application/ld+json" set:html={JSON.stringify(schemaBreadcrumb)} />
<script type="application/ld+json" set:html={JSON.stringify(schemaFAQ)} />

<Layout
  title={`${servico.title(zona.nome)} | Prime Estores`}
  description={servico.description(zona.nome)}
  keywords={servico.keywords(zona.nome)}
  canonicalURL={pageUrl}
>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-[#1A1A1A] to-[#8B1A1A] text-white py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol class="flex flex-wrap items-center gap-2 text-sm text-white/80">
          <li><a href="/" class="hover:text-white transition-colors">Início</a></li>
          <li aria-hidden="true"><span>/</span></li>
          <li><a href="/zonas-que-servimos" class="hover:text-white transition-colors">Zonas</a></li>
          <li aria-hidden="true"><span>/</span></li>
          <li><a href={`/zonas/${zona.slug}`} class="hover:text-white transition-colors">{zona.nome}</a></li>
          <li aria-hidden="true"><span>/</span></li>
          <li><span class="text-white">{servico.nome}</span></li>
        </ol>
      </nav>
      <div class="max-w-3xl">
        <span class="inline-block bg-white/10 border border-white/20 text-white text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full mb-4">{servico.nome} · {zona.nome}</span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black leading-tight mb-4">
          {servico.h1(zona.nome)}
        </h1>
        <p class="text-xl text-white/80 leading-relaxed mb-8">
          {servico.intro(zona)}
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/orcamento" class="inline-flex items-center justify-center gap-2 bg-white text-[#8B1A1A] font-bold px-6 py-3.5 rounded-lg hover:bg-gray-100 transition-colors">
            Pedir Orçamento Grátis
          </a>
          <a href="tel:+351923348323" class="inline-flex items-center justify-center gap-2 border-2 border-white text-white font-bold px-6 py-3.5 rounded-lg hover:bg-white/10 transition-colors">
            +351 923 348 323
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Content -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-12">

        <!-- Main -->
        <div class="lg:col-span-2 space-y-10">
          <div>
            <h2 class="text-2xl lg:text-3xl font-black text-[#1A1A1A] mb-4">
              {servico.nome} em {zona.nome}
            </h2>
            <p class="text-gray-600 leading-relaxed mb-4">{servico.intro(zona)}</p>
            <p class="text-gray-600 leading-relaxed">{servico.detail(zona)}</p>
          </div>

          <!-- Pricing -->
          <div>
            <h2 class="text-xl lg:text-2xl font-black text-[#1A1A1A] mb-3">{sd.pricingTitle}</h2>
            <p class="text-gray-600 leading-relaxed mb-5">{sd.pricingIntro}</p>
            <div class="rounded-2xl border border-gray-200 overflow-hidden">
              {sd.pricing.map((p, i) => (
                <div class={`flex justify-between items-center gap-4 px-5 py-3.5 ${i % 2 === 0 ? 'bg-[#F5F5F5]' : 'bg-white'}`}>
                  <span class="text-gray-700 text-sm">{p.label}</span>
                  <span class="text-[#8B1A1A] font-bold text-sm whitespace-nowrap">{p.value}</span>
                </div>
              ))}
            </div>
            <p class="text-gray-400 text-xs mt-3">{sd.pricingNote}</p>
          </div>

          <!-- Neighborhoods -->
          <div>
            <h2 class="text-xl font-black text-[#1A1A1A] mb-4">
              {servico.nome} disponível em todo o concelho de {zona.nome}
            </h2>
            <div class="flex flex-wrap gap-2">
              {zona.bairros.map(b => (
                <span class="bg-[#F5F5F5] text-gray-700 text-sm font-medium px-3 py-1.5 rounded-full border border-gray-200">
                  {b}
                </span>
              ))}
            </div>
          </div>

          <!-- Other services in this zona -->
          <div>
            <h2 class="text-xl font-black text-[#1A1A1A] mb-4">
              Outros serviços em {zona.nome}
            </h2>
            <div class="grid sm:grid-cols-3 gap-4">
              {outros.map(s => (
                <a
                  href={`/zonas/${zona.slug}/${s.slug}`}
                  class="group bg-white rounded-xl p-4 border border-gray-200 hover:border-[#8B1A1A] hover:shadow-md transition-all"
                >
                  <div class="font-bold text-[#1A1A1A] text-sm group-hover:text-[#8B1A1A] transition-colors">{s.nome}</div>
                  <span class="text-[#8B1A1A] text-xs font-semibold group-hover:underline">em {zona.nome} →</span>
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
          <div class="bg-[#8B1A1A] rounded-2xl p-6 text-white">
            <h3 class="font-black text-lg mb-2">Orçamento em {zona.nome}</h3>
            <p class="text-red-100 text-sm mb-5 leading-relaxed">{servico.nome} em {zona.nome} com orçamento gratuito e sem compromisso.</p>
            <a href="/orcamento" class="block w-full text-center bg-white text-[#8B1A1A] font-bold px-4 py-3 rounded-lg hover:bg-gray-100 transition-colors mb-3">
              Formulário de orçamento
            </a>
            <a href="tel:+351923348323" class="block w-full text-center border-2 border-white text-white font-bold px-4 py-3 rounded-lg hover:bg-white/10 transition-colors text-sm">
              +351 923 348 323
            </a>
          </div>
          <div class="bg-[#F5F5F5] rounded-2xl p-6">
            <h3 class="font-bold text-[#1A1A1A] mb-4 text-sm uppercase tracking-wide">Informações</h3>
            <div class="space-y-3 text-sm">
              {[
                'Resposta em menos de 24h',
                'Garantia de 1 ano',
                'Orçamento 100% gratuito',
                'Técnicos certificados',
                'Seg – Sáb: 8h00 – 20h00',
              ].map(item => (
                <div class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-[#8B1A1A] flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  <span class="text-gray-600">{item}</span>
                </div>
              ))}
            </div>
          </div>
          <div class="bg-white rounded-2xl p-6 border border-gray-100">
            <h3 class="font-bold text-[#1A1A1A] mb-3 text-sm uppercase tracking-wide">Ver mais</h3>
            <div class="space-y-2">
              <a href={`/zonas/${zona.slug}`} class="block text-[#8B1A1A] text-sm font-semibold hover:underline">
                Todos os serviços em {zona.nome} →
              </a>
              <a href={servico.serviceHref} class="block text-[#8B1A1A] text-sm font-semibold hover:underline">
                {servico.nome} (informação geral) →
              </a>
              <a href="/zonas-que-servimos" class="block text-[#8B1A1A] text-sm font-semibold hover:underline">
                Outras zonas →
              </a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 bg-[#F5F5F5]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl lg:text-3xl font-black text-[#1A1A1A] mb-8 text-center">{sd.faqTitle}</h2>
      <div class="space-y-4">
        {sd.faq.map(item => (
          <details class="group bg-white rounded-xl border border-gray-200 overflow-hidden">
            <summary class="flex justify-between items-center gap-4 cursor-pointer px-5 py-4 font-semibold text-[#1A1A1A] text-sm list-none">
              {item.q}
              <svg class="w-5 h-5 text-[#8B1A1A] flex-shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </summary>
            <div class="px-5 pb-4 text-gray-600 text-sm leading-relaxed">{item.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-[#1A1A1A] text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl lg:text-3xl font-black mb-4">
        {servico.nome} em {zona.nome}? Fale connosco hoje
      </h2>
      <p class="text-gray-400 text-lg mb-8 max-w-2xl mx-auto">
        Orçamento gratuito e sem compromisso. Deslocamo-nos a {zona.nome} de segunda a sábado das 8h às 20h.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/orcamento" class="inline-flex items-center justify-center gap-2 bg-[#8B1A1A] text-white font-bold px-8 py-4 rounded-lg hover:bg-[#7a1717] transition-colors">
          Pedir Orçamento Grátis
        </a>
        <a href="tel:+351923348323" class="inline-flex items-center justify-center gap-2 border-2 border-white/30 text-white font-bold px-8 py-4 rounded-lg hover:bg-white/10 transition-colors">
          +351 923 348 323
        </a>
      </div>
    </div>
  </section>

</Layout>
